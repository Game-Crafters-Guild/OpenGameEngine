#version 450

// Ring gather adapted from FidelityFX DoF 1.1. Near and far fields are kept
// separate; far rings are traversed outside-in and coverage-composited to
// approximate occlusion. Custom aperture sampling preserves GameEngine bokeh.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D uHalfColorCoc;
layout(set = 0, binding = 1) uniform sampler2D uDilatedCoc;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D uNearField;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D uFarField;

layout(push_constant) uniform DofPC
{
    float dofIntensity;
    float dofMaxRadius;
    float dofFocusDistance;
    float dofFocalLengthMm;
    float dofAperture;
    float dofSensorHeightMm;
    int dofApertureBladeCount;
    float dofApertureRoundness;
    float dofApertureRotation;
    float dofAnamorphicSqueeze;
    int dofDebugMode;
    float dofDebugAlpha;
    int dofSamplingQuality;
} pc;

const float PI = 3.14159265359;
const float TAU = 6.28318530718;
// AMD's reference effect expresses quality as a maximum ring count. Ten rings
// is its sample application's default; higher presets retain headroom for the
// engine's polygonal and anamorphic apertures without returning to an
// area-sized disk budget.
const int kMaxSampleRings = 20;
const int kMaxSamplesPerRing = 256;

float SamplePhase(ivec2 p)
{
    // Stable per-pixel Cranley-Patterson rotation. Large CoCs eventually hit
    // the bounded sample budget; decorrelating neighbouring kernels turns the
    // remaining error into fine spatial noise instead of repeated bright tap
    // copies that reproduce the aperture silhouette.
    return TAU * fract(52.9829189 * fract(
        0.06711056 * float(p.x) + 0.00583715 * float(p.y)));
}

float ApertureRadius(float angle)
{
    float blades = float(clamp(pc.dofApertureBladeCount, 3, 16));
    float sector = TAU / blades;
    float rotatedAngle = angle - radians(pc.dofApertureRotation);
    float localAngle = mod(rotatedAngle + 0.5 * sector + PI, sector) - 0.5 * sector;
    float polygon = cos(PI / blades) / max(cos(localAngle), 1e-4);
    return mix(polygon, 1.0, clamp(pc.dofApertureRoundness, 0.0, 1.0));
}

vec2 ShapedOffset(float angle, float radius)
{
    vec2 o = vec2(cos(angle), sin(angle)) * radius * ApertureRadius(angle);
    o.y *= clamp(pc.dofAnamorphicSqueeze, 1.0, 4.0);
    return o;
}

float CocReach(float cocRadius, float sampleRadius)
{
    // Preserve the previous half-pixel boundary while narrowing its one-pixel
    // ramp. This makes every authored aperture shape more defined without
    // reintroducing hard, aliased edges.
    return smoothstep(-0.7, -0.3, cocRadius - sampleRadius);
}

float Luminance(vec3 color)
{
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

vec4 SampleHighlightSoftened(vec2 uv, float kernelRadius)
{
    vec4 center = textureLod(uHalfColorCoc, uv, 0.0);
    float centerLuma = Luminance(center.rgb);
    if (centerLuma <= 1.0)
        return center;

    // Isolated HDR highlights expose individual gather taps at very large
    // radii. Prefilter only high-contrast energy; retain the centre CoC so the
    // authored aperture boundary and ordinary bokeh coverage are unchanged.
    vec2 texelSize = 1.0 / vec2(textureSize(uHalfColorCoc, 0));
    float footprint = mix(0.75, 1.75,
        clamp((kernelRadius - 8.0) / 120.0, 0.0, 1.0));
    vec2 dx = vec2(footprint * texelSize.x, 0.0);
    vec2 dy = vec2(0.0, footprint * texelSize.y);
    vec3 neighbours =
        textureLod(uHalfColorCoc, clamp(uv - dx, vec2(0.0), vec2(1.0)), 0.0).rgb +
        textureLod(uHalfColorCoc, clamp(uv + dx, vec2(0.0), vec2(1.0)), 0.0).rgb +
        textureLod(uHalfColorCoc, clamp(uv - dy, vec2(0.0), vec2(1.0)), 0.0).rgb +
        textureLod(uHalfColorCoc, clamp(uv + dy, vec2(0.0), vec2(1.0)), 0.0).rgb;
    neighbours *= 0.25;

    float relativeContrast = max(centerLuma - Luminance(neighbours), 0.0) /
        max(centerLuma, 1e-4);
    float highlightMask = smoothstep(1.0, 4.0, centerLuma) *
        smoothstep(0.15, 0.65, relativeContrast);
    vec3 filtered = mix(center.rgb, neighbours, 0.65);
    return vec4(mix(center.rgb, filtered, highlightMask), center.a);
}

void main()
{
    ivec2 size = imageSize(uNearField);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size)))
        return;

    vec2 centerPx = vec2(p) + 0.5;
    vec2 uv = centerPx / vec2(size);
    vec4 center = texelFetch(uHalfColorCoc, p, 0);
    // Bilinear tile lookup prevents the foreground coverage radius from
    // changing in visible 8x8 half-resolution steps at tile boundaries.
    vec2 tileRadii = textureLod(uDilatedCoc, uv, 0.0).rg;
    float nearRadius = max(tileRadii.x, max(center.a, 0.0));
    // Far blur is a gather at the current surface, so its own CoC is the
    // kernel radius. Using the tile maximum here produced square halos around
    // silhouettes whenever a neighbouring tile contained a larger CoC.
    float farRadius = max(-center.a, 0.0);
    float kernelRadius = max(nearRadius, farRadius);

    if (kernelRadius < 0.5)
    {
        imageStore(uNearField, p, vec4(0.0));
        imageStore(uFarField, p, vec4(center.rgb, center.a < -0.5 ? 1.0 : 0.0));
        return;
    }

    vec3 nearSum = vec3(0.0);
    vec3 farSum = vec3(0.0);
    float nearWeight = 0.0;
    float farWeight = 0.0;
    float totalWeight = 0.0;

    float samplePhase = SamplePhase(p);
    int quality = clamp(pc.dofSamplingQuality, 0, 2);
    // Balanced deliberately leaves enough GPU headroom for a complete 60 Hz
    // editor frame at the native Game View resolution. Quality retains the
    // full ring budget for offline captures and higher-end targets.
    int maxRings = quality == 0 ? 6
        : (quality == 1 ? 10 : kMaxSampleRings);
    int ringCount = clamp(int(ceil(kernelRadius)), 1, maxRings);
    float ringStep = kernelRadius / float(ringCount);
    float squeeze = clamp(pc.dofAnamorphicSqueeze, 1.0, 4.0);
    // Straight blades and stretched lenses need more angular coverage, but
    // still scale linearly with ring count rather than with kernel area.
    float shapeDensity = mix(1.12, 1.0,
        clamp(pc.dofApertureRoundness, 0.0, 1.0));
    float anamorphicDensity = sqrt(squeeze);

    // Traverse outside-in like FidelityFX DoF. Equal-weight taps are area
    // preserving because ring sample count grows with circumference.
    for (int ring = 0; ring < kMaxSampleRings; ++ring)
    {
        if (ring >= ringCount) break;
        int ringOrdinal = ringCount - ring;
        float radius = ringStep * float(ringOrdinal);
        int ringSamples = clamp(
            int(ceil(6.25 * float(ringOrdinal) * shapeDensity * anamorphicDensity)),
            6, kMaxSamplesPerRing);
        float angleStep = TAU / float(ringSamples);
        // Alternating half-steps keep radial spokes from lining up while the
        // per-pixel phase turns any remaining undersampling into fine noise.
        float ringPhase = samplePhase + (ring & 1) * 0.5 * angleStep;

        for (int i = 0; i < kMaxSamplesPerRing; ++i)
        {
            if (i >= ringSamples) break;
            float angle = ringPhase + angleStep * float(i);
            vec2 qPx = centerPx + ShapedOffset(angle, radius);
            vec2 qUv = clamp(qPx / vec2(size), vec2(0.0), vec2(1.0));
            vec4 s = SampleHighlightSoftened(qUv, kernelRadius);
            float nearReach = CocReach(s.a, radius);
            float farReach = CocReach(-s.a, radius);
            nearSum += s.rgb * nearReach;
            farSum += s.rgb * farReach;
            nearWeight += nearReach;
            farWeight += farReach;
            totalWeight += 1.0;
        }
    }

    // Always include the center in its own signed field. This stabilizes tiny
    // radii and guarantees a valid color when a silhouette rejects most taps.
    if (center.a > 0.0) { nearSum += center.rgb; nearWeight += 1.0; }
    if (center.a < 0.0) { farSum += center.rgb; farWeight += 1.0; }

    vec3 nearColor = nearWeight > 1e-5 ? nearSum / nearWeight : center.rgb;
    vec3 farColor = farWeight > 1e-5 ? farSum / farWeight : center.rgb;
    // Tile dilation only tells this pixel that a blurred contributor may
    // reach it. Fade the layer in as that candidate radius crosses the
    // half-pixel activation threshold; otherwise the hard early-out above
    // becomes a visible rectangular/scalloped contour at dilation-tile edges.
    float kernelFade = smoothstep(0.5, 1.5, kernelRadius);
    float nearOpacity = center.a > 0.5
        ? 1.0 : clamp(nearWeight / max(totalWeight, 1.0), 0.0, 1.0);
    float farOpacity = center.a < -0.5
        ? 1.0 : clamp(farWeight / max(totalWeight, 1.0), 0.0, 1.0);
    nearOpacity *= kernelFade;
    farOpacity *= kernelFade;

    imageStore(uNearField, p, vec4(nearColor, nearOpacity));
    imageStore(uFarField, p, vec4(farColor, farOpacity));
}

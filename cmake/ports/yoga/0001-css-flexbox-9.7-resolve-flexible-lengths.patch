+// The sizing state of one flex item while flexible lengths are being resolved.
+// flexBaseSize is the spec's flex base size, hypotheticalSize is that clamped
+// by the item's own min/max, and targetSize is what the line has agreed to give
+// the item so far.
+struct FlexItemSizing {
+  float flexBaseSize{0.0f};
+  float hypotheticalSize{0.0f};
+  float targetSize{0.0f};
+  float violation{0.0f};
+  bool frozen{false};
+};
+
+// Resolving Flexible Lengths
+// (https://www.w3.org/TR/CSS-flexbox-1/#resolve-flexible-lengths).
+//
+// Each distribution shares the free space over the items that are still
+// flexible, clamps every target to that item's min/max, and freezes the items
+// violating in the same direction the line as a whole is violating. Freezing
+// changes the space the next distribution has to share, so an item can come
+// into violation only after a sibling has frozen, which is why the number of
+// distributions is data-dependent rather than fixed. The loop ends when nothing
+// freezes, i.e. when every target sits within its own bounds.
+//
+// Free space is measured from FLEX BASE SIZES throughout, never from clamped
+// ones: measuring it from a clamped basis and then flexing on top of the clamp
+// grows a min-clamped item past its minimum and lets a max-clamped item under
+// shrink overflow the line.
+static std::vector<FlexItemSizing> resolveTargetMainSizes(
+    const FlexLine& flexLine,
+    const Direction direction,
+    const FlexDirection mainAxis,
+    const float ownerWidth,
+    const float mainAxisOwnerSize,
+    const float availableInnerMainDim,
+    const float availableInnerWidth) {
+  const size_t itemCount = flexLine.itemsInFlow.size();
+  std::vector<FlexItemSizing> items(itemCount);
+
+  // The space the items themselves may occupy. remainingFreeSpace is what is
+  // left of the line once every hypothetical size, margin and gap is taken out,
+  // so adding the hypothetical sizes back recovers the item budget without
+  // needing the margin and gap total a second time.
+  float spaceForItems = flexLine.layout.remainingFreeSpace;
+  for (size_t i = 0; i < itemCount; i++) {
+    const yoga::Node* const child = flexLine.itemsInFlow[i];
+    items[i].flexBaseSize = child->getLayout().computedFlexBasis.unwrap();
+    items[i].hypotheticalSize = boundAxisWithinMinAndMax(
+                                    child,
+                                    direction,
+                                    mainAxis,
+                                    child->getLayout().computedFlexBasis,
+                                    mainAxisOwnerSize,
+                                    ownerWidth)
+                                    .unwrap();
+    items[i].targetSize = items[i].hypotheticalSize;
+    spaceForItems += items[i].hypotheticalSize;
+  }
+
+  if (yoga::isUndefined(flexLine.layout.remainingFreeSpace)) {
+    return items;
+  }
+
+  // The line grows only when the hypothetical sizes leave room. At exactly zero
+  // there is nothing to distribute in either direction and the loop below
+  // settles every item on its hypothetical size.
+  const bool useGrow = flexLine.layout.remainingFreeSpace > 0;
+
+  // Items that cannot move in the line's direction never take part.
+  for (size_t i = 0; i < itemCount; i++) {
+    const yoga::Node* const child = flexLine.itemsInFlow[i];
+    const float factor =
+        useGrow ? child->resolveFlexGrow() : child->resolveFlexShrink();
+    const bool clampedAwayFromTheLine = useGrow
+        ? items[i].flexBaseSize > items[i].hypotheticalSize
+        : items[i].flexBaseSize < items[i].hypotheticalSize;
+    items[i].frozen = yoga::isUndefined(factor) || factor == 0.0f ||
+        yoga::isUndefined(items[i].flexBaseSize) || clampedAwayFromTheLine;
+  }
+
+  float initialFreeSpace = spaceForItems;
+  for (const FlexItemSizing& item : items) {
+    initialFreeSpace -= item.frozen ? item.targetSize : item.flexBaseSize;
+  }
+
+  // Every distribution either freezes an item or is the last one, so the item
+  // count bounds the loop independently of the exit conditions inside it.
+  for (size_t distribution = 0; distribution <= itemCount; distribution++) {
+    float unfrozenFlexFactors = 0.0f;
+    float unfrozenScaledShrinkFactors = 0.0f;
+    float committedSpace = 0.0f;
+    size_t unfrozenCount = 0;
+
+    for (size_t i = 0; i < itemCount; i++) {
+      if (items[i].frozen) {
+        committedSpace += items[i].targetSize;
+        continue;
+      }
+      const yoga::Node* const child = flexLine.itemsInFlow[i];
+      const float factor =
+          useGrow ? child->resolveFlexGrow() : child->resolveFlexShrink();
+      unfrozenCount++;
+      committedSpace += items[i].flexBaseSize;
+      unfrozenFlexFactors += factor;
+      unfrozenScaledShrinkFactors += factor * items[i].flexBaseSize;
+    }
+
+    if (unfrozenCount == 0) {
+      break;
+    }
+
+    // Flex factors that do not add up to one only ever distribute that fraction
+    // of the space the line started with, so the items keep the gap between
+    // them instead of filling the container.
+    float freeSpace = spaceForItems - committedSpace;
+    if (unfrozenFlexFactors < 1.0f) {
+      const float scaledFreeSpace = initialFreeSpace * unfrozenFlexFactors;
+      if (std::abs(scaledFreeSpace) < std::abs(freeSpace)) {
+        freeSpace = scaledFreeSpace;
+      }
+    }
+
+    for (size_t i = 0; i < itemCount; i++) {
+      if (items[i].frozen) {
+        continue;
+      }
+      const yoga::Node* const child = flexLine.itemsInFlow[i];
+      // Shrinking is proportional to the shrink factor SCALED BY the flex base
+      // size, so a large item gives up more than a small one at the same
+      // flex-shrink; growing is proportional to the raw factor.
+      const float share = useGrow
+          ? (unfrozenFlexFactors != 0.0f
+                 ? child->resolveFlexGrow() / unfrozenFlexFactors
+                 : 0.0f)
+          : (unfrozenScaledShrinkFactors != 0.0f
+                 ? (child->resolveFlexShrink() * items[i].flexBaseSize) /
+                     unfrozenScaledShrinkFactors
+                 : 0.0f);
+      items[i].targetSize = items[i].flexBaseSize + freeSpace * share;
+    }
+
+    float totalViolation = 0.0f;
+    for (size_t i = 0; i < itemCount; i++) {
+      if (items[i].frozen) {
+        continue;
+      }
+      const float clamped = boundAxis(
+          flexLine.itemsInFlow[i],
+          mainAxis,
+          direction,
+          items[i].targetSize,
+          availableInnerMainDim,
+          availableInnerWidth);
+      items[i].violation = clamped - items[i].targetSize;
+      items[i].targetSize = clamped;
+      totalViolation += items[i].violation;
+    }
+
+    // The sign of the total decides which violations are real. When the line as
+    // a whole comes up short, only the items being held UP by a minimum are
+    // settled; the items held down by a maximum stay flexible so the next
+    // distribution can move them again.
+    bool anythingFroze = false;
+    for (size_t i = 0; i < itemCount; i++) {
+      if (items[i].frozen) {
+        continue;
+      }
+      const bool freeze = totalViolation > 0.0f ? items[i].violation > 0.0f
+          : totalViolation < 0.0f              ? items[i].violation < 0.0f
+                                               : true;
+      if (freeze) {
+        items[i].frozen = true;
+        anythingFroze = true;
+      }
+    }
+
+    if (!anythingFroze) {
+      break;
+    }
+  }
+
+  return items;
+}

#version 450

#define GE_VOLUMETRIC_FOG_BIND_JITTER_ATLAS 1
#include "volumetric_fog_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;
layout(rgba16f, set = 0, binding = 0) uniform writeonly image3D uOutFiltered;
layout(set = 0, binding = 1) uniform sampler3D uLighting;

// Denoise radiance within similar media and lighting regions. Keep extinction
// at the center cell so filtering cannot spread fog into empty space.

// Bilateral falloff over the relative difference to the center cell. Density
// separates fog from empty space, so it rejects harder than radiance does; the
// radiance floor keeps a near-black neighbourhood from reading as a huge
// relative difference and blocking its own blur.
const float kDensityRejection = 8.0;
const float kRadianceRejection = 4.0;
const float kRadianceFloor = 0.02;

void main()
{
    ivec3 gid = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 grid = ivec3(fog.uGridParams.xyz);
    if (any(greaterThanEqual(gid, grid)))
        return;

    const float w[3] = float[3](0.25, 0.5, 0.25);
    vec4 center = texelFetch(uLighting, gid, 0);
    vec3 sum = vec3(0.0);
    float weightSum = 0.0;
    for (int dy = -1; dy <= 1; ++dy)
    {
        for (int dx = -1; dx <= 1; ++dx)
        {
            ivec3 s = clamp(gid + ivec3(dx, dy, 0), ivec3(0), grid - ivec3(1));
            float weight = w[dx + 1] * w[dy + 1];
            vec4 neighbor = texelFetch(uLighting, s, 0);
            float densityDelta = abs(neighbor.a - center.a) /
                max(max(neighbor.a, center.a), 1.0e-5);
            float radianceDelta = length(neighbor.rgb - center.rgb) /
                max(max(length(neighbor.rgb), length(center.rgb)), kRadianceFloor);
            weight *= exp(-kDensityRejection * densityDelta - kRadianceRejection * radianceDelta);
            sum += neighbor.rgb * weight;
            weightSum += weight;
        }
    }

    imageStore(uOutFiltered, gid, vec4(sum / max(weightSum, 1.0e-4), center.a));
}

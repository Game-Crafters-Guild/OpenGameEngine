#version 450

// SDSM receiver reduce over a single-sample depth (MSAA off, or a resolved
// copy). The body, and what it measures, is Includes/shadow_receiver_reduce.glsl;
// depth_reduce_ms.comp is the multisampled twin. ShadowReceiverReduce picks the
// variant from the depth's own sample count at declare time.

layout(set = 0, binding = 0) uniform sampler2D DepthTex;

#define GE_RECEIVER_DEPTH(pixel) texelFetch(DepthTex, (pixel), 0).r

#include "Includes/shadow_receiver_reduce.glsl"

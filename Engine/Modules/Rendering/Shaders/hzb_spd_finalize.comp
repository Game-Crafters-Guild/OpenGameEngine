#version 450

// HZB downsample, finalize pass (2 of 2) — companion to hzb_spd.comp.
// ONE workgroup, dispatched only when mipCount >= 3.
//
// The tile pass built mips 0..6 with plain clamped 2x2 for levels 2..6, which
// misses the trailing odd-extent folds. That wrongness is confined to each
// level's global last row/column (a level's last row/column feeds only the
// NEXT level's last row/column), so this pass recomputes exactly those texels
// with the exact hzb_build.comp rule — ascending, so each level's source is
// fully exact when read — then builds mips 7..12 whole-level from LDS.
//
// Memory model: NO coherent anywhere. Values this dispatch itself produced
// are never re-read through images — a level's fixed edges ride an LDS
// overlay (eCol/eRow, read via EdgeAwareLoad), mip 7 rides a whole-level LDS
// tile, and deeper levels ping-pong LDS tiles. Image loads only ever touch
// tile-pass output (made visible by the render-graph barrier between the two
// dispatches); image stores are never loaded back.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Mips 1..12 as single-mip views (slot i = mip i+1). Reads mips 1..6
// (interior texels only), writes mips 2..12. No texel is both read and
// written in this dispatch, so no access qualifier and no coherent.
layout(set = 0, binding = 0, r32f) uniform image2D uMips[12];

layout(push_constant) uniform PushConstants
{
    uint width;    // depth / mip 0 extent
    uint height;
    uint mipCount; // full chain length incl. mip 0 (CPU guards mip7 <= 32^2)
};

// Edge overlay: level m's fixed last column/row live at parity slot [m & 1].
// Sized for mip 2 of the largest supported depth extent (4223 >> 2 = 1055).
const int kMaxEdge = 1056;
shared float eCol[2][kMaxEdge];
shared float eRow[2][kMaxEdge];
// Whole-level tiles for mips 7+ (mip 7 capped at 32x32 by the CPU guard).
shared float tA[32][32];
shared float tB[16][16];

ivec2 LevelExtent(uint m)
{
    return ivec2(int(max(1u, width >> m)), int(max(1u, height >> m)));
}

float LoadMip(uint m, ivec2 c) // m in 1..12 -> uMips[m-1]
{
    switch (m)
    {
        case 1u:  return imageLoad(uMips[0], c).r;
        case 2u:  return imageLoad(uMips[1], c).r;
        case 3u:  return imageLoad(uMips[2], c).r;
        case 4u:  return imageLoad(uMips[3], c).r;
        case 5u:  return imageLoad(uMips[4], c).r;
        default:  return imageLoad(uMips[5], c).r;
    }
}

void StoreMip(uint m, ivec2 c, float v) // m in 2..12 -> uMips[m-1]
{
    const vec4 t = vec4(v, 0.0, 0.0, 0.0);
    switch (m)
    {
        case 2u:  imageStore(uMips[1], c, t); break;
        case 3u:  imageStore(uMips[2], c, t); break;
        case 4u:  imageStore(uMips[3], c, t); break;
        case 5u:  imageStore(uMips[4], c, t); break;
        case 6u:  imageStore(uMips[5], c, t); break;
        case 7u:  imageStore(uMips[6], c, t); break;
        case 8u:  imageStore(uMips[7], c, t); break;
        case 9u:  imageStore(uMips[8], c, t); break;
        case 10u: imageStore(uMips[9], c, t); break;
        case 11u: imageStore(uMips[10], c, t); break;
        default:  imageStore(uMips[11], c, t); break;
    }
}

// Source load for the exact rule: interior texels come from the tile-pass
// image; a fixed level's (srcMip >= 2) last column/row come from the LDS
// overlay written by the previous fixup iteration. `c` is pre-clamped.
float EdgeAwareLoad(uint srcMip, ivec2 c, ivec2 srcExt)
{
    if (srcMip >= 2u)
    {
        if (c.x == srcExt.x - 1)
            return eCol[srcMip & 1u][c.y];
        if (c.y == srcExt.y - 1)
            return eRow[srcMip & 1u][c.x];
    }
    return LoadMip(srcMip, c);
}

// hzb_build.comp's mode-1 rule verbatim (same operation order — bit parity):
// clamped 2x2 MIN plus the trailing fold on the last row/column when the
// source extent is odd. Sources via EdgeAwareLoad.
float ReduceExact(uint srcMip, ivec2 d, ivec2 dstExt, ivec2 srcExt)
{
    const ivec2 maxSrc = srcExt - ivec2(1);
    const ivec2 base = d * 2;
    float farthest = EdgeAwareLoad(srcMip, clamp(base, ivec2(0), maxSrc), srcExt);
    farthest = min(farthest, EdgeAwareLoad(srcMip, clamp(base + ivec2(1, 0), ivec2(0), maxSrc), srcExt));
    farthest = min(farthest, EdgeAwareLoad(srcMip, clamp(base + ivec2(0, 1), ivec2(0), maxSrc), srcExt));
    farthest = min(farthest, EdgeAwareLoad(srcMip, clamp(base + ivec2(1, 1), ivec2(0), maxSrc), srcExt));

    const bool oddW = (uint(srcExt.x) & 1u) != 0u;
    const bool oddH = (uint(srcExt.y) & 1u) != 0u;
    const bool lastCol = d.x == dstExt.x - 1;
    const bool lastRow = d.y == dstExt.y - 1;
    if (oddW && lastCol)
    {
        farthest = min(farthest, EdgeAwareLoad(srcMip, clamp(base + ivec2(2, 0), ivec2(0), maxSrc), srcExt));
        farthest = min(farthest, EdgeAwareLoad(srcMip, clamp(base + ivec2(2, 1), ivec2(0), maxSrc), srcExt));
    }
    if (oddH && lastRow)
    {
        farthest = min(farthest, EdgeAwareLoad(srcMip, clamp(base + ivec2(0, 2), ivec2(0), maxSrc), srcExt));
        farthest = min(farthest, EdgeAwareLoad(srcMip, clamp(base + ivec2(1, 2), ivec2(0), maxSrc), srcExt));
    }
    if (oddW && oddH && lastCol && lastRow)
        farthest = min(farthest, EdgeAwareLoad(srcMip, clamp(base + ivec2(2, 2), ivec2(0), maxSrc), srcExt));
    return farthest;
}

void main()
{
    const ivec2 lid = ivec2(gl_LocalInvocationID.xy);
    const uint flatIdx = gl_LocalInvocationIndex;

    // ── Fold fixup for mips 2..6: recompute each level's global last column
    // + last row. The column arm covers the full height (incl. the corner,
    // mirrored into eRow); the row arm covers x in [0, dstW-1) so no texel is
    // written twice.
    for (uint m = 2u; m < mipCount && m <= 6u; ++m)
    {
        const ivec2 dstExt = LevelExtent(m);
        const ivec2 srcExt = LevelExtent(m - 1u);
        const uint edgeItems = uint(dstExt.y) + uint(dstExt.x) - 1u;
        for (uint i = flatIdx; i < edgeItems; i += 256u)
        {
            const bool isCol = i < uint(dstExt.y);
            const ivec2 d = isCol ? ivec2(dstExt.x - 1, int(i))
                                  : ivec2(int(i) - dstExt.y, dstExt.y - 1);
            const float v = ReduceExact(m - 1u, d, dstExt, srcExt);
            StoreMip(m, d, v);
            if (isCol)
            {
                eCol[m & 1u][d.y] = v;
                if (d.y == dstExt.y - 1)
                    eRow[m & 1u][d.x] = v; // corner mirror
            }
            else
            {
                eRow[m & 1u][d.x] = v;
            }
        }
        barrier();
    }

    if (mipCount <= 7u)
        return;

    // ── Mip 7: whole level (<= 32x32) via EdgeAwareLoad over the fixed mip 6.
    {
        const ivec2 dstExt = LevelExtent(7u);
        const ivec2 srcExt = LevelExtent(6u);
        const uint texels = uint(dstExt.x) * uint(dstExt.y);
        for (uint i = flatIdx; i < texels; i += 256u)
        {
            const ivec2 d = ivec2(int(i % uint(dstExt.x)), int(i / uint(dstExt.x)));
            const float v = ReduceExact(6u, d, dstExt, srcExt);
            StoreMip(7u, d, v);
            tA[d.y][d.x] = v;
        }
    }

    // ── Mips 8..12: whole level from the LDS tile ping-pong; the exact rule
    // (incl. folds) reads only the previous level's tile.
#define GE_SPD_TAIL_LEVEL(dstMip, SRC, DST)                                                    \
    barrier();                                                                                 \
    if (mipCount > uint(dstMip))                                                                  \
    {                                                                                          \
        const ivec2 dstExt = LevelExtent(uint(dstMip));                                           \
        const ivec2 srcExt = LevelExtent(uint(dstMip) - 1u);                                      \
        const ivec2 maxS = srcExt - ivec2(1);                                                  \
        const uint texels = uint(dstExt.x) * uint(dstExt.y);                                   \
        for (uint i = flatIdx; i < texels; i += 256u)                                          \
        {                                                                                      \
            const ivec2 d = ivec2(int(i % uint(dstExt.x)), int(i / uint(dstExt.x)));           \
            const ivec2 b = d * 2;                                                             \
            ivec2 c0 = clamp(b, ivec2(0), maxS);                                               \
            ivec2 c1 = clamp(b + ivec2(1, 0), ivec2(0), maxS);                                 \
            ivec2 c2 = clamp(b + ivec2(0, 1), ivec2(0), maxS);                                 \
            ivec2 c3 = clamp(b + ivec2(1, 1), ivec2(0), maxS);                                 \
            float farthest = SRC[c0.y][c0.x];                                                  \
            farthest = min(farthest, SRC[c1.y][c1.x]);                                         \
            farthest = min(farthest, SRC[c2.y][c2.x]);                                         \
            farthest = min(farthest, SRC[c3.y][c3.x]);                                         \
            const bool oddW = (uint(srcExt.x) & 1u) != 0u;                                     \
            const bool oddH = (uint(srcExt.y) & 1u) != 0u;                                     \
            const bool lastCol = d.x == dstExt.x - 1;                                          \
            const bool lastRow = d.y == dstExt.y - 1;                                          \
            if (oddW && lastCol)                                                               \
            {                                                                                  \
                ivec2 f0 = clamp(b + ivec2(2, 0), ivec2(0), maxS);                             \
                ivec2 f1 = clamp(b + ivec2(2, 1), ivec2(0), maxS);                             \
                farthest = min(farthest, SRC[f0.y][f0.x]);                                     \
                farthest = min(farthest, SRC[f1.y][f1.x]);                                     \
            }                                                                                  \
            if (oddH && lastRow)                                                               \
            {                                                                                  \
                ivec2 f2 = clamp(b + ivec2(0, 2), ivec2(0), maxS);                             \
                ivec2 f3 = clamp(b + ivec2(1, 2), ivec2(0), maxS);                             \
                farthest = min(farthest, SRC[f2.y][f2.x]);                                     \
                farthest = min(farthest, SRC[f3.y][f3.x]);                                     \
            }                                                                                  \
            if (oddW && oddH && lastCol && lastRow)                                            \
            {                                                                                  \
                ivec2 f4 = clamp(b + ivec2(2, 2), ivec2(0), maxS);                             \
                farthest = min(farthest, SRC[f4.y][f4.x]);                                     \
            }                                                                                  \
            StoreMip(uint(dstMip), d, farthest);                                                  \
            DST[d.y][d.x] = farthest;                                                          \
        }                                                                                      \
    }

    GE_SPD_TAIL_LEVEL(8, tA, tB)
    GE_SPD_TAIL_LEVEL(9, tB, tA)
    GE_SPD_TAIL_LEVEL(10, tA, tB)
    GE_SPD_TAIL_LEVEL(11, tB, tA)
    GE_SPD_TAIL_LEVEL(12, tA, tB)
#undef GE_SPD_TAIL_LEVEL
}

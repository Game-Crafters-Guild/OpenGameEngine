#version 460
#extension GL_EXT_ray_query : require

// DDGI probe classification kernel (M3). Shoots a small fixed set of short
// rays from each probe's CURRENT resolved position (grid position + its own
// persistent relocation offset, read back at the top of this dispatch — this
// kernel iterates its own output across frames, refining the offset as
// geometry moves; each probe's slot is only ever touched by that probe's own
// workgroup, so no cross-probe synchronization is needed). Rays that hit a
// BACKFACE (rayQueryGetIntersectionFrontFaceEXT == false) close to the probe
// mean the probe is embedded in geometry — count > kBuriedFraction of the
// fixed ray set backface-hitting marks the probe inactive so the forward
// consumer (Includes/ddgi_probes.glsl) excludes it from the trilinear gather
// instead of contributing a wrong, buried sample. The nearest backface hit
// also drives a small relocation nudge (push the probe back along that ray's
// direction, capped to a fraction of one grid cell) so a probe that is only
// marginally embedded (e.g. sitting exactly on a thin wall) can work its way
// back out over a few frames and reactivate.
//
// This is a documented simplification of the technique published DDGI
// implementations use (RTXGI's classification+relocation is a multi-ray
// consensus with its own tuned constants) — sufficient for this engine's
// gate (buried probes deactivate, wall-leak scenes stay clean) without
// porting a second un-verified set of proprietary tuning constants.
//
// One workgroup per probe, GE_DDGI_CLASSIFY_RAYS threads (one ray each). Ray
// results land in per-invocation shared-memory slots (own slot only — race
// free) so invocation 0 can do a race-free serial reduction after a barrier,
// rather than needing atomics to track "closest backface hit."

#include "Includes/ddgi_common.glsl"

const uint GE_DDGI_CLASSIFY_RAYS = 32u;
const float GE_DDGI_CLASSIFY_BURIED_FRACTION = 0.25;
const float GE_DDGI_CLASSIFY_MAX_RELOCATE_CELL = 0.45;  // fraction of minCellWS
// Clearance a probe wants from the nearest FRONTFACE, as a fraction of the
// cell. Two of the reference's three relocation branches hinge on it: a probe
// closer than this is crowded and steps away, and a probe further than this
// walks its offset back down. Without the second branch an offset is a one-way
// door — a probe displaced by geometry that has since moved stays displaced.
const float GE_DDGI_CLASSIFY_MIN_FRONTFACE_CELL = 0.2;

layout(local_size_x = GE_DDGI_CLASSIFY_RAYS, local_size_y = 1, local_size_z = 1) in;

layout(std140, set = 0, binding = 0) uniform DDGIClassifyParams
{
    vec4 uGridMinWS;
    vec4 uGridSizeWS;
    ivec4 uProbeCount;   // xyz = res; w = probeTotal
    vec4 uParams0;       // x = minCellWS
    uvec4 uDispatch0;    // x = probeBase, y = probesThisTick, z = frameIndex (ray-set rotation)
} DDGIParams;

// Descriptor-bound scene TLAS — see ddgi_trace_hw.comp for why this is not an
// accelerationStructureEXT(uvec2) address cast.
layout(set = 0, binding = 2) uniform accelerationStructureEXT uTlas;

// xyz = persistent relocation offset (world-space), w = active (1.0) /
// inactive (0.0). Read AND written here (self-only per probe); read-only by
// ddgi_trace_hw.comp (applies the offset) and Includes/ddgi_probes.glsl
// (applies the offset to the Chebyshev reference position and zero-weights
// inactive corners).
// Pre-scroll cell record (Includes/ddgi_common.glsl's GE_DDGIProbeCellId);
// ddgi_blend.comp stamps it after this pass.
layout(std430, set = 0, binding = 3) buffer DDGIProbeCellRW
{
    vec4 ge_ddgiProbeCell[];
};

layout(std430, set = 0, binding = 1) buffer DDGIProbeState
{
    vec4 ge_ddgiProbeState[];
};

// xyz = hit direction (only meaningful when w < GE_DDGI_T_MAX), w = backface
// hit distance or GE_DDGI_T_MAX as a "not a backface hit" sentinel. Each
// invocation writes only sSlot[gl_LocalInvocationID.x] — no race.
shared vec4 sSlot[GE_DDGI_CLASSIFY_RAYS];    // backface hits: xyz = dir, w = t
shared vec4 sFront[GE_DDGI_CLASSIFY_RAYS];   // frontface hits, same packing

void main()
{
    uint probeLocal = gl_WorkGroupID.x;
    int probeIdx = int(DDGIParams.uDispatch0.x) + int(probeLocal);
    if (probeLocal >= DDGIParams.uDispatch0.y || probeIdx >= DDGIParams.uProbeCount.w)
        return;

    GE_DDGIGridInfo grid;
    grid.gridMinWS = DDGIParams.uGridMinWS.xyz;
    grid.gridSizeWS = DDGIParams.uGridSizeWS.xyz;
    grid.probeCount = DDGIParams.uProbeCount.xyz;
    grid.probeTotal = DDGIParams.uProbeCount.w;
    grid.minCellWS = DDGIParams.uParams0.x;

    // A slot handed to a new world cell by a scroll carries another place's
    // relocation; start it from the lattice like a fresh probe.
    vec3 prevOffset = GE_DDGIProbeCellChanged(ge_ddgiProbeCell[probeIdx], grid, probeIdx)
                          ? vec3(0.0)
                          : ge_ddgiProbeState[probeIdx].xyz;
    vec3 probePosWS = GE_DDGIProbePosition(grid, probeIdx) + prevOffset;

    uint rayIdx = gl_LocalInvocationID.x;
    // Rotating the fixed 32-ray set each tick (M4) lets different sample
    // directions probe the same probe's surroundings over consecutive
    // ticks, instead of perpetually missing a marginal burial the M2/M3
    // fixed set's blind spots happened to miss.
    vec3 dir = GE_DDGIRayDirection(rayIdx, GE_DDGI_CLASSIFY_RAYS, GE_DDGIRayBasis(DDGIParams.uDispatch0.z));
    float maxDist = max(grid.minCellWS * 2.0, 1.0e-3);

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, uTlas, gl_RayFlagsOpaqueEXT, 0xFFu,
                          probePosWS, GE_DDGI_RAY_EPS, dir, maxDist);
    while (rayQueryProceedEXT(rq)) { }

    vec4 mySlot = vec4(0.0, 0.0, 0.0, GE_DDGI_T_MAX);
    vec4 myFront = vec4(0.0, 0.0, 0.0, GE_DDGI_T_MAX);
    if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT)
    {
        vec4 hit = vec4(dir, rayQueryGetIntersectionTEXT(rq, true));
        if (rayQueryGetIntersectionFrontFaceEXT(rq, true))
            myFront = hit;
        else
            mySlot = hit;
    }
    sSlot[rayIdx] = mySlot;
    sFront[rayIdx] = myFront;
    barrier();

    if (rayIdx != 0u)
        return;

    uint backfaceCount = 0u;
    float closestT = GE_DDGI_T_MAX;
    vec3 closestDir = vec3(0.0);
    float closestFrontT = GE_DDGI_T_MAX;
    vec3 closestFrontDir = vec3(0.0);
    float farthestFrontT = 0.0;
    vec3 farthestFrontDir = vec3(0.0);
    for (uint i = 0u; i < GE_DDGI_CLASSIFY_RAYS; ++i)
    {
        vec4 f = sFront[i];
        if (f.w < GE_DDGI_T_MAX)
        {
            if (f.w < closestFrontT) { closestFrontT = f.w; closestFrontDir = f.xyz; }
            if (f.w > farthestFrontT) { farthestFrontT = f.w; farthestFrontDir = f.xyz; }
        }
        vec4 s = sSlot[i];
        if (s.w >= GE_DDGI_T_MAX)
            continue;
        ++backfaceCount;
        if (s.w < closestT)
        {
            closestT = s.w;
            closestDir = s.xyz;
        }
    }

    bool buried = (float(backfaceCount) / float(GE_DDGI_CLASSIFY_RAYS)) > GE_DDGI_CLASSIFY_BURIED_FRACTION;
    // Three branches, following the reference: step out of geometry, step away
    // from a crowding surface, or walk back toward the cell centre once there
    // is room. The third is what makes relocation reversible.
    float maxRelocate = grid.minCellWS * GE_DDGI_CLASSIFY_MAX_RELOCATE_CELL;
    float minFront = grid.minCellWS * GE_DDGI_CLASSIFY_MIN_FRONTFACE_CELL;
    vec3 newOffset = prevOffset;
    if (buried && closestT < GE_DDGI_T_MAX)
    {
        // Move along the closest backface ray, past the surface plus half the
        // clearance, so the probe lands outside rather than on the boundary.
        newOffset += closestDir * (closestT + minFront * 0.5);
    }
    else if (closestFrontT < minFront)
    {
        // Crowded. Retreat along the FARTHEST frontface ray, and only when it
        // opposes the crowding one — otherwise both directions are blocked and
        // moving would trade one wall for another.
        if (farthestFrontT > 0.0 && dot(closestFrontDir, farthestFrontDir) <= 0.0)
            newOffset += farthestFrontDir * min(farthestFrontT, minFront);
    }
    else if (closestFrontT > minFront)
    {
        // Room to spare: give back as much offset as the clearance allows, so a
        // probe displaced by geometry that has moved on returns to its cell.
        float offsetLen = length(prevOffset);
        if (offsetLen > 1.0e-5)
            newOffset -= normalize(prevOffset) * min(closestFrontT - minFront, offsetLen);
    }
    float newLen = length(newOffset);
    if (newLen > maxRelocate)
        newOffset *= maxRelocate / newLen;

    newOffset = GE_DDGIStableRelocation(prevOffset, newOffset, grid.minCellWS);
    vec3 displacement = newOffset - prevOffset;
    float relocationDelta = length(displacement);
    bool crossedGeometry = false;
    if (relocationDelta > GE_DDGI_RAY_EPS)
    {
        rayQueryEXT crossing;
        rayQueryInitializeEXT(crossing, uTlas, gl_RayFlagsOpaqueEXT, 0xFFu,
                              probePosWS, GE_DDGI_RAY_EPS,
                              displacement / relocationDelta, relocationDelta);
        while (rayQueryProceedEXT(crossing)) { }
        crossedGeometry = rayQueryGetIntersectionTypeEXT(crossing, true) !=
                          gl_RayQueryCommittedIntersectionNoneEXT;
    }
    newOffset = GE_DDGIConstrainRelocation(prevOffset, newOffset, buried, crossedGeometry);
    crossedGeometry = crossedGeometry && any(notEqual(newOffset, prevOffset));
    if (GE_DDGIResetRelocationHistory(ge_ddgiProbeState[probeIdx].w > 0.5, buried, crossedGeometry))
        ge_ddgiProbeCell[probeIdx] = vec4(vec3(GE_DDGI_PROBE_CELL_UNSTAMPED), 1.0);

    ge_ddgiProbeState[probeIdx] = vec4(newOffset, buried ? 0.0 : 1.0);
}

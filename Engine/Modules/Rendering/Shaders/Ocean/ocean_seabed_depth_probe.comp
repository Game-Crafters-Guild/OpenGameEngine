#version 450
#extension GL_GOOGLE_include_directive : require

#include "Ocean/ocean_common.glsl"

layout(local_size_x = 1) in;
layout(std430, set = 0, binding = 0) writeonly buffer SeabedProbeResult
{
    vec4 result;
};

void main()
{
    // Use the shipped sample and full parameter block, including fields on
    // either side of the repaired lane and in its runtime-sized tail.
    result = vec4(OceanSampleSeabedDepth(vec2(1.0)), uDepthFogFalloff.w,
                  uCausticsScale, uWaves[0].Amplitude);
}

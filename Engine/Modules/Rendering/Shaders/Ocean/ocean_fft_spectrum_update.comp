#version 450
// Ocean FFT: time-evolve H0 into the spectral height + horizontal displacement
// for the current time. Ported from the reference FFTSpectrum.compute::SpectrumUpdate
// (MIT). Runs every frame. Outputs complex H, X, Z (still in frequency domain).

#include "Ocean/ocean_fft_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1, rgba32f) uniform readonly  image2DArray uH0;
layout(set = 0, binding = 2, rgba32f)   uniform writeonly image2DArray uHeight;
layout(set = 0, binding = 3, rgba32f)   uniform writeonly image2DArray uDisplaceX;
layout(set = 0, binding = 4, rgba32f)   uniform writeonly image2DArray uDisplaceZ;

void main()
{
    const uint res = uResolution;
    const ivec3 id = ivec3(gl_GlobalInvocationID);
    if (uint(id.x) >= res || uint(id.y) >= res || uint(id.z) >= uCascadeCount)
        return;

    const ivec2 center = ivec2(res / 2u);
    const ivec2 coord = id.xy - center;

    const float worldSize = OceanFFTWorldSize(uint(id.z));
    const vec2 k = GE_FFT_PI2 * vec2(coord) / worldSize;
    const float kMag = length(k);
    if (kMag < 1.0e-6)
    {
        imageStore(uHeight, id, vec4(0.0));
        imageStore(uDisplaceX, id, vec4(0.0));
        imageStore(uDisplaceZ, id, vec4(0.0));
        return;
    }

    // Per-octave band of this wavenumber. Drives the gravity scale (must match the
    // init pass so the time evolution and the H0 amplitudes agree) and the chop.
    const float wavelength = GE_FFT_PI2 / kMag;
    const float octaveIndex = log2(wavelength) - GE_SPECTRUM_SMALLEST_WL_P2;

    float w;
    float dwdk;
    OceanDeepDispersionG(kMag, uGravity * OceanSampleGravityScale(octaveIndex), w, dwdk);

    const float sw = sin(w * uTime);
    const float cw = cos(w * uTime);
    const vec2 fwd = vec2(cw, -sw);
    const vec2 bkwd = vec2(cw, sw);

    const vec4 h0 = imageLoad(uH0, id);
    const vec2 h = OceanCMul(h0.xy, fwd) + OceanCMul(h0.zw, bkwd);

    const float chop = OceanSampleChop(octaveIndex);
    const float kInv = 1.0 / kMag;
    imageStore(uHeight, id, vec4(h, 0.0, 0.0));
    imageStore(uDisplaceX, id, vec4(chop * vec2(-h.y * k.x, h.x * k.x) * kInv, 0.0, 0.0));
    imageStore(uDisplaceZ, id, vec4(chop * vec2(-h.y * k.y, h.x * k.y) * kInv, 0.0, 0.0));
}

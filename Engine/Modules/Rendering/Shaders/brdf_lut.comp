#version 450

// Split-sum BRDF integration LUT generator (Unreal-style)
// Outputs RG16F where:
//   R = scale term (Fresnel/F90 term dependent)
//   G = bias term
// Coordinates: x = NdotV in [0,1], y = Roughness in [0,1]
// Reference: Epic/Unreal implementation and common PBR literature

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// The storage format has to name the texture's actual format, and the compat
// profile's is wider: WebGPU's storage-capable list has no rg16float, so
// CreateBrdfLut allocates rgba16float there (see ImageBasedLightingFeature).
// Only the first two channels are ever sampled.
#if defined(GE_COMPAT_PROFILE)
layout(binding = 0, rgba16f) writeonly uniform image2D uBrdfLUT;
#else
layout(binding = 0, rg16f) writeonly uniform image2D uBrdfLUT;
#endif

// ----------------------------------------------------------------------------
// Utility functions
// ----------------------------------------------------------------------------
float RadicalInverse_VdC(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10; // / 0x100000000
}

vec2 Hammersley(uint i, uint N) {
    return vec2(float(i) / float(N), RadicalInverse_VdC(i));
}

vec3 ImportanceSampleGGX(vec2 Xi, float roughness, vec3 N) {
    float a = roughness * roughness;
    float phi = 2.0 * 3.141592653589793 * Xi.x;
    float cosTheta = sqrt((1.0 - Xi.y) / (1.0 + (a * a - 1.0) * Xi.y));
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

    vec3 H = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);

    // Orthonormal basis (T, B, N)
    vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 T = normalize(cross(up, N));
    vec3 B = cross(N, T);

    // Tangent space to world
    return normalize(T * H.x + B * H.y + N * H.z);
}

float GeometrySchlickGGX(float NdotV, float roughness) {
    float r = roughness + 1.0;
    float k = (r * r) / 8.0; // UE4: k = (alpha + 1)^2 / 8
    float denom = NdotV * (1.0 - k) + k;
    return NdotV / denom;
}

float GeometrySmith(float NdotV, float NdotL, float roughness) {
    float ggx1 = GeometrySchlickGGX(NdotV, roughness);
    float ggx2 = GeometrySchlickGGX(NdotL, roughness);
    return ggx1 * ggx2;
}

// ----------------------------------------------------------------------------
// Integrate BRDF for given NdotV and roughness (split-sum approximation)
// Returns vec2(scale, bias)
// ----------------------------------------------------------------------------
vec2 IntegrateBRDF(float NdotV, float roughness) {
    const uint SAMPLE_COUNT = 1024u;

    vec3 V = vec3(sqrt(1.0 - NdotV * NdotV), 0.0, NdotV);
    vec3 N = vec3(0.0, 0.0, 1.0);

    float A = 0.0;
    float B = 0.0;

    for (uint i = 0u; i < SAMPLE_COUNT; ++i) {
        vec2 Xi = Hammersley(i, SAMPLE_COUNT);
        vec3 H = ImportanceSampleGGX(Xi, roughness, N);
        vec3 L = normalize(2.0 * dot(V, H) * H - V);

        float NdotL = max(L.z, 0.0);
        float NdotH = max(H.z, 0.0);
        float VdotH = max(dot(V, H), 0.0);

        if (NdotL > 0.0) {
            float G = GeometrySmith(N.z, NdotL, roughness);
            float G_Vis = (G * VdotH) / max(NdotH * N.z, 1e-4);
            float Fc = pow(1.0 - VdotH, 5.0);

            A += (1.0 - Fc) * G_Vis;
            B += Fc * G_Vis;
        }
    }

    A /= float(SAMPLE_COUNT);
    B /= float(SAMPLE_COUNT);
    return vec2(A, B);
}

void main() {
    ivec2 size = imageSize(uBrdfLUT);
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= size.x || pix.y >= size.y) return;

    vec2 uv = vec2(pix) / vec2(max(size - 1, ivec2(1))); // [0,1]
    float NdotV = clamp(uv.x, 0.0, 1.0);
    float roughness = clamp(uv.y, 0.0, 1.0);

    vec2 brdf = IntegrateBRDF(NdotV, roughness);
    imageStore(uBrdfLUT, pix, vec4(brdf, 0.0, 1.0));
}


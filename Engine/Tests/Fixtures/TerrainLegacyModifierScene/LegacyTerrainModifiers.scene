[scene name="LegacyTerrainModifiers" version=1]

; The retired pre-volume terrain-modifier FILE FORMAT, one entity per block type.
;
; The five pre-volume modifier components are gone from the engine; their
; property blocks are not, because scene files on disk still carry them. This
; fixture is the on-disk half of that contract: a scene that names all five,
; loaded through the registered schemas, must come back as modifier volumes plus
; effects and must re-save with no legacy block left. Nothing else in the repo
; carries these blocks, so without this file the load path they exist for has no
; test that reads a real scene.
;
; DO NOT "modernise" it into volumes and effects — the legacy spelling IS the
; fixture. Values are deliberately off their defaults (except on flat_middle,
; below), so a migration that dropped a field would land on the default and be
; caught rather than agree by coincidence.
;
; The modifiers here are never baked: this is a load/migration fixture, so the
; spline volumes carry a spline for shape realism but no terrain bake reads them.


[entity id="terrain"]
HierarchyOrder.order = 0
Name.value = "Terrain"
Terrain.enabled = true
Terrain.sizeX = 512
Terrain.sizeZ = 512
Terrain.heightScale = 100
Terrain.samplesPerMeter = 1
Terrain.renderLayerMask = 1
Terrain.castShadows = true
Terrain.receiveShadows = true
Transform.position = (0, 0, 0)
Transform.rotation = (0, 0, 0, 1)
Transform.scale = (1, 1, 1)


; Two pre-volume modifiers over ONE shared region on ONE entity — the shape the
; Biggles landscape carried, transcribed field for field when that scene was
; re-saved clean. Both blocks spell the same region, so the load migrates
; them into a single volume with two stacked effects and reports no region
; conflict. Its values are the authored ones, defaults and all; the entities
; below are what pin the field carry-over.
[entity id="flat_middle" parent="terrain"]
HierarchyOrder.order = 0
Name.value = "Flat Middle"
TerrainFlattenModifier.shape = 0
TerrainFlattenModifier.radius = 75
TerrainFlattenModifier.rectHalfX = 50
TerrainFlattenModifier.rectHalfZ = 50
TerrainFlattenModifier.falloff = 100
TerrainFlattenModifier.priority = 0
TerrainFlattenModifier.enabled = true
TerrainFlattenModifier.targetHeight = 0
TerrainFlattenModifier.useEntityHeight = true
TerrainNoiseModifier.shape = 0
TerrainNoiseModifier.radius = 75
TerrainNoiseModifier.rectHalfX = 50
TerrainNoiseModifier.rectHalfZ = 50
TerrainNoiseModifier.falloff = 100
TerrainNoiseModifier.priority = 0
TerrainNoiseModifier.enabled = true
TerrainNoiseModifier.blend = 1
TerrainNoiseModifier.frequency = 8
TerrainNoiseModifier.amplitude = 5
TerrainNoiseModifier.octaves = 4
TerrainNoiseModifier.seed = 0
TerrainNoiseModifier.lacunarity = 2
TerrainNoiseModifier.persistence = 0.5
Transform.position = (0, 29.9389, 0)
Transform.rotation = (0, 0, 0, 1)
Transform.scale = (1, 1, 1)


; Flatten to an ABSOLUTE height: useEntityHeight false is the branch flat_middle
; does not take, and the one where targetHeight survives the migration instead of
; being mapped to a zero offset.
[entity id="pad_absolute" parent="terrain"]
HierarchyOrder.order = 10
Name.value = "Landing Pad"
TerrainFlattenModifier.shape = 1
TerrainFlattenModifier.radius = 18
TerrainFlattenModifier.rectHalfX = 34
TerrainFlattenModifier.rectHalfZ = 22
TerrainFlattenModifier.falloff = 7.5
TerrainFlattenModifier.priority = 6
TerrainFlattenModifier.enabled = true
TerrainFlattenModifier.targetHeight = 42.5
TerrainFlattenModifier.useEntityHeight = false
Transform.position = (140, 12, -60)
Transform.rotation = (0, 0, 0, 1)
Transform.scale = (1, 1, 1)


; Noise with every field off its default, including blendSmoothing — a scene
; authored after that field appeared. Its absence on flat_middle covers the
; older spelling.
[entity id="noise_dunes" parent="terrain"]
HierarchyOrder.order = 20
Name.value = "Dunes"
TerrainNoiseModifier.shape = 1
TerrainNoiseModifier.radius = 40
TerrainNoiseModifier.rectHalfX = 65
TerrainNoiseModifier.rectHalfZ = 25
TerrainNoiseModifier.falloff = 12.5
TerrainNoiseModifier.priority = 3
TerrainNoiseModifier.enabled = true
TerrainNoiseModifier.blend = 2
TerrainNoiseModifier.frequency = 6.5
TerrainNoiseModifier.amplitude = 18
TerrainNoiseModifier.octaves = 3
TerrainNoiseModifier.seed = 91
TerrainNoiseModifier.lacunarity = 2.1
TerrainNoiseModifier.persistence = 0.45
TerrainNoiseModifier.blendSmoothing = 1.75
Transform.position = (-120, 4, 90)
Transform.rotation = (0, 0, 0, 1)
Transform.scale = (1, 1, 1)


; Stamp, authored DISABLED: enabled is a shared base field whose carry-over onto
; the effect is otherwise unexercised by any scene on disk.
[entity id="stamp_crater" parent="terrain"]
HierarchyOrder.order = 30
Name.value = "Crater"
TerrainStampModifier.shape = 0
TerrainStampModifier.radius = 55
TerrainStampModifier.rectHalfX = 30
TerrainStampModifier.rectHalfZ = 30
TerrainStampModifier.falloff = 8
TerrainStampModifier.priority = 2
TerrainStampModifier.enabled = false
TerrainStampModifier.blend = 5
TerrainStampModifier.heightScale = 22
TerrainStampModifier.rotation = 37
TerrainStampModifier.stampAsset = "3f7c1d20-95a4-4e6b-9a11-6c8d2b4f0e77"
TerrainStampModifier.blendSmoothing = 2.5
Transform.position = (60, 0, 175)
Transform.rotation = (0, 0, 0, 1)
Transform.scale = (1, 1, 1)


[entity id="paint_scree" parent="terrain"]
HierarchyOrder.order = 40
Name.value = "Scree"
TerrainPaintLayerModifier.shape = 1
TerrainPaintLayerModifier.radius = 20
TerrainPaintLayerModifier.rectHalfX = 45
TerrainPaintLayerModifier.rectHalfZ = 18
TerrainPaintLayerModifier.falloff = 6
TerrainPaintLayerModifier.priority = 1
TerrainPaintLayerModifier.enabled = true
TerrainPaintLayerModifier.layerIndex = 2

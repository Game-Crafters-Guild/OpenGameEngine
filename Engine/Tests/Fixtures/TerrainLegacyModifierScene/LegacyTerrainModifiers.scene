TerrainPaintLayerModifier.replace = true
Transform.position = (-40, 0, -150)
Transform.rotation = (0, 0, 0, 1)
Transform.scale = (1, 1, 1)


; Spline modifier, FLATTEN branch with painting on: migrates to a SplineArea

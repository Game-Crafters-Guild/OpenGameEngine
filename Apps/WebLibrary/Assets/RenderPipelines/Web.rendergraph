      },
      "shaderPkg": "Shaders/bloom_downsample.shaderpkg",
      "skipWhen": {
        "bloomOctave8Active": 0.0
      },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "BloomOctaveGather",
      "inputs": {
        "uBloom0": "BloomA",
        "uBloom1": "BloomQuarter",
        "uBloom2": "BloomEighth",
        "uBloom3": "BloomSixteenth",
        "uBloom4": "BloomThirtySecond",
        "uBloom5": "BloomSixtyFourth",
        "uBloom6": "BloomOneTwentyEighth",
        "uBloom7": "BloomTwoFiftySixth"
      },
      "output": "BloomNormalized",
      "passthroughInput": "uBloom0",
      "ppOverrides": true,
      "pushConstants": {
        "bloomOctaveBlend": 1.0,
        "bloomOctaves": 3,
        "bloomSampleScale": 1.0,
        "bloomScatter": 0.5
      },
      "samplers": {
        "uBloom0": "LinearClamp",
        "uBloom1": "LinearClamp",
        "uBloom2": "LinearClamp",
        "uBloom3": "LinearClamp",
        "uBloom4": "LinearClamp",
        "uBloom5": "LinearClamp",
        "uBloom6": "LinearClamp",
        "uBloom7": "LinearClamp"
      },
      "shaderPkg": "Shaders/bloom_octave_gather.shaderpkg",
      "skipWhen": {

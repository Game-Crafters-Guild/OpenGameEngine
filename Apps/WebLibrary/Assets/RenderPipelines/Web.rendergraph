        "bloomDepthVeilTintB": 1.0,
        "bloomDepthVeilTintG": 1.0,
        "bloomDepthVeilTintR": 1.0,
        "bloomLensDirtIntensity": 0.0,
        "bloomLensDirtVignette": 0,
        "bloomLensDirtVignetteColorB": 1.0,
        "bloomLensDirtVignetteColorG": 1.0,
        "bloomLensDirtVignetteColorR": 1.0,
        "bloomLensDirtVignetteIntensity": 1.0,
        "bloomLensDirtVignetteRadius": 0.25,
        "bloomLensDirtVignetteRounded": 0,
        "bloomLensDirtVignetteSmoothness": 0.2,
        "bloomTintB": 1.0,
        "bloomTintG": 1.0,
        "bloomTintR": 1.0,
        "intensity": 1.0
      },
      "samplers": {
        "uHDR": "LinearClamp",
        "uLensBloom": "LinearClamp",
        "uLensDirt": "LinearClamp"
      },
      "serviceTextures": [
        "uLensDirt"
      ],
      "shaderPkg": "Shaders/bloom_lens_dirt.shaderpkg",
      "skipWhen": {
        "bloomLensDirtActive": 0.0
      },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "AutoExposure",
      "input": "HDRSSSR",
      "type": "AutoExposure"
    },
    {
      "bufferUsages": {
        "uExposure": "Storage"
      },
      "buffers": {
        "uExposure": "ExposureHistory"
      },
      "enabled": true,
      "id": "Tonemap",
      "inputs": {
        "uHDRColor": "HDRBloomWithDirt"
      },
      "output": "LDRFinal",
      "ppOverrides": true,
      "pushConstants": {
        "ditherMode": 0,
        "exposure": 1.0,
        "outEncoding": 0,
        "paperWhiteNits": 350.0,
        "tonemapMode": 4,

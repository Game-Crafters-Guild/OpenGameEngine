        "uBloom2": "LinearClamp",
        "uBloom3": "LinearClamp",
        "uBloom4": "LinearClamp",
        "uBloom5": "LinearClamp",
        "uBloom6": "LinearClamp",
        "uBloom7": "LinearClamp"
      },
      "shaderPkg": "Shaders/bloom_octave_gather.shaderpkg",
      "skipWhen": {
        "bloomScatteringActive": 0.0
      },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "BloomCombine",
      "inputGates": {
        "uBloom": "bloomHighlightsActive",
        "uScattering": "bloomScatteringActive"
      },
      "inputs": {
        "uBloom": "BloomNormalized",
        "uHDR": "HDRSSSR",
        "uScattering": "ScatteringNormalized"
      },
      "output": "HDRCombined",
      "passthroughInput": "uHDR",
      "ppOverrides": true,
      "pushConstants": {
        "bloomDepthVeilEnabled": 0,
        "bloomDepthVeilEnd": 500.0,
        "bloomDepthVeilIntensity": 0.0,
        "bloomDepthVeilStart": 25.0,
        "bloomDepthVeilTintB": 1.0,
        "bloomDepthVeilTintG": 1.0,
        "bloomDepthVeilTintR": 1.0,
        "bloomScatteringAmount": 0.0,

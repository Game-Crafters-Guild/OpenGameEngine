{
  "outputs": {
    "FinalColor": "View.Resolve"
  },
  "passes": [
    {
      "buffer": "ViewParams",
      "enabled": true,
      "id": "ViewParamsUpload",
      "type": "ViewParamsUpload"
    },
    {
      "enabled": true,
      "id": "TerrainUpload",
      "type": "TerrainUpload"
    },
    {
      "enabled": true,
      "id": "CBTTerrain",
      "type": "CBTRender"
    },
    {
      "enabled": true,
      "id": "TerrainGrass",
      "type": "TerrainGrass"
    },
    {
      "enabled": true,
      "id": "DepthPrepass",
      "type": "DepthPrepass"
    },
    {
      "enabled": true,
      "id": "DepthResolve",
      "type": "DepthResolve"
    },
    {
      "enabled": true,
      "id": "DDGI",
      "type": "DDGIGen"
    },
    {
      "buffer": "LightBuffer",
      "enabled": true,
      "id": "LightUpload",
      "type": "LightUpload"
    },
    {
      "bufferUsages": {
        "DepthMinMaxBuffer": "StorageWrite"
      },
      "buffers": {
        "DepthMinMaxBuffer": "DepthMinMaxBuffer"
      },
      "dispatch": {
        "x": "ceil(renderWidth / 32)",
        "y": "ceil(renderHeight / 32)",
        "z": 1
      },
      "enabled": true,
      "id": "DepthMinMax",
      "inputUsages": {
        "DepthTex": "Sampled"
      },
      "inputs": {
        "DepthTex": "View.DepthResolved"
      },
      "shaderPkg": "Shaders/cluster_depth_minmax.shaderpkg",
      "targetBuffer": "DepthMinMaxBuffer",
      "type": "ComputeShader"
    },
    {
      "buffer": "ShadowData",
      "cascades": 4,
      "depthBias": 0.0001,
      "enabled": true,
      "fitShadowDistanceToScene": true,
      "id": "CascadedShadowMap",
      "maxShadowDistance": 200.0,
      "normalBias": 0.5,
      "resolution": 2048,
      "splitLambda": 0.75,
      "type": "ShadowMap"
    },
    {
      "bufferUsages": {
        "ClusterBuffer": "StorageWrite",
        "ClusterParams": "Sampled",
        "DepthMinMaxBuffer": "StorageRead",
        "LightBuffer": "StorageRead",
        "LightIndexBuffer": "StorageWrite",
        "ViewParams": "ConstantBuffer"
      },
      "buffers": {
        "ClusterBuffer": "ClusterBuffer",
        "ClusterParams": "ClusterParams",
        "DepthMinMaxBuffer": "DepthMinMaxBuffer",
        "LightBuffer": "LightBuffer",
        "LightIndexBuffer": "LightIndexBuffer",
        "ViewParams": "ViewParams"
      },
      "dispatch": {
        "x": "ceil(renderWidth / 32)",
        "y": "ceil(renderHeight / 32)",
        "z": 24
      },
      "enabled": true,
      "id": "ClusteredLightCull",
      "requiresLights": true,
      "shaderPkg": "Shaders/clustered_light_cull.shaderpkg",
      "targetBuffer": "LightIndexBuffer",
      "type": "ComputeShader",
      "uniformWrites": {
        "ClusterParams": {
          "u32x4": [
            32,
            32,
            24,
            32
          ]
        }
      }
    },
    {
      "enabled": true,
      "id": "Sky",
      "output": "View.Color",
      "type": "SkyRender"
    },
    {
      "enabled": true,
      "id": "IBLGen",
      "type": "IBLGen"
    },
    {
      "colorResolveTarget": "SceneColor",
      "enabled": true,
      "id": "World",
      "keywords": [
        "ForwardPlus",
        "Instanced",
        "Shadows",
        "IBL"
      ],
      "type": "WorldRender"
    },
    {
      "enabled": true,
      "id": "Transmissive",
      "keywords": [
        "ForwardPlus",
        "Instanced",
        "Shadows",
        "IBL"
      ],
      "type": "TransmissiveRender"
    },
    {
      "enabled": true,
      "id": "HZBBuild",
      "type": "HZBBuild"
    },
    {
      "enabled": true,
      "id": "ScreenSpaceReflections",
      "input": "SceneColor",
      "output": "HDRSSSR",
      "type": "ScreenSpaceReflections"
    },
    {
      "enabled": true,
      "id": "SunGlare",
      "output": "HDRSSSR",
      "type": "SunGlare"
    },
    {
      "bufferUsages": {
        "ViewParams": "ConstantBuffer",
        "uExposure": "Storage"
      },
      "buffers": {
        "ViewParams": "ViewParams",
        "uExposure": "ExposureHistory"
      },
      "enabled": true,
      "id": "BloomThreshold",
      "inputUsages": {
        "uDepth": "Sampled"
      },
      "inputs": {
        "uDepth": "View.DepthResolved",
        "uHDR": "HDRSSSR"
      },
      "output": "BloomA",
      "ppOverrides": true,
      "pushConstants": {
        "bloomAntiFlicker": 1,
        "bloomDepthVeilEnabled": 0,
        "bloomDepthVeilEnd": 500.0,
        "bloomDepthVeilIntensity": 1.0,
        "bloomDepthVeilStart": 25.0,
        "exposure": 1.0,
        "knee": 0.1,
        "threshold": 1.0,
        "thresholdFree": 0,
        "useAutoExposure": 0
      },
      "samplers": {
        "uDepth": "PointClamp",
        "uHDR": "LinearClamp"
      },
      "shaderPkg": "Shaders/bloom_threshold.shaderpkg",
      "skipWhen": {
        "bloomHighlightsActive": 0.0
      },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "BloomDownQuarter",
      "inputs": {
        "uSrc": "BloomA"
      },
      "output": "BloomQuarter",
      "ppOverrides": true,
      "pushConstants": {
        "reserved": 0.0
      },
      "samplers": {
        "uSrc": "LinearClamp"
      },
      "shaderPkg": "Shaders/bloom_downsample.shaderpkg",
      "skipWhen": {
        "bloomHighlightsActive": 0.0
      },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "BloomDownEighth",
      "inputs": {
        "uSrc": "BloomQuarter"
      },
      "output": "BloomEighth",
      "ppOverrides": true,
      "pushConstants": {
        "reserved": 0.0
      },
      "samplers": {
        "uSrc": "LinearClamp"
      },
      "shaderPkg": "Shaders/bloom_downsample.shaderpkg",
      "skipWhen": {
        "bloomHighlightsActive": 0.0
      },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "BloomDownSixteenth",
      "inputs": {
        "uSrc": "BloomEighth"
      },
      "output": "BloomSixteenth",
      "ppOverrides": true,
      "pushConstants": {
        "reserved": 0.0
      },
      "samplers": {
        "uSrc": "LinearClamp"
      },
      "shaderPkg": "Shaders/bloom_downsample.shaderpkg",
      "skipWhen": {
        "bloomOctave4Active": 0.0
      },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "BloomDownThirtySecond",
      "inputs": {
        "uSrc": "BloomSixteenth"
      },
      "output": "BloomThirtySecond",
      "ppOverrides": true,
      "pushConstants": {
        "reserved": 0.0
      },
      "samplers": {
        "uSrc": "LinearClamp"
      },
      "shaderPkg": "Shaders/bloom_downsample.shaderpkg",
      "skipWhen": {
        "bloomOctave5Active": 0.0
      },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,

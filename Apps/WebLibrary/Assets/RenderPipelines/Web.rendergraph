      },
      "samplers": {
        "uHDRColor": "LinearClamp"
      },
      "shaderPkg": "Shaders/tonemap.shaderpkg",
      "type": "FullscreenShader"
    },
    {
      "elideWhenIdentity": true,
      "enabled": true,
      "id": "FinalCopy",
      "inputs": {
        "uTex": "LDRFinal"
      },
      "output": "View.Resolve",
      "samplers": {
        "uTex": "LinearClamp"
      },
      "shaderPkg": "Shaders/copy.shaderpkg",
      "type": "FullscreenShader"
    }
  ],
  "pipelineName": "Web Library",

        "uScattering": "LinearClamp"
      },
      "shaderPkg": "Shaders/bloom_combine.shaderpkg",
      "skipWhen": {
        "bloomChainActive": 0.0
      },
      "type": "FullscreenShader"
    },
    {
      "assetTextures": {
        "uLensDirt": "Textures/Bloom/lensDirt1.png"
      },
      "enabled": true,
      "id": "BloomLensDirtComposite",
      "inputs": {
        "uHDR": "HDRCombined",
        "uLensBloom": "BloomLensDirtLight"
      },
      "output": "HDRBloomWithDirt",
      "passthroughInput": "uHDR",

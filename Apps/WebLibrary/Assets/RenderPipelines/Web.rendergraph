        "uBloom2": "ScatteringEighth",
        "uBloom3": "ScatteringSixteenth",
        "uBloom4": "ScatteringThirtySecond",
        "uBloom5": "ScatteringSixtyFourth",
        "uBloom6": "ScatteringOneTwentyEighth",
        "uBloom7": "ScatteringTwoFiftySixth"
      },
      "output": "ScatteringNormalized",
      "passthroughInput": "uBloom0",
      "ppOverrides": true,

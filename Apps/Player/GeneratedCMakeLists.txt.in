# Auto-generated by GameEngine Build Pipeline
# This file compiles the Player executable from user + template sources
# and links against the GameEngine SDK.

cmake_minimum_required(VERSION 3.25)
project("@GE_GAME_NAME@" LANGUAGES CXX)

# Find the GameEngine SDK
find_package(GameEngine REQUIRED PATHS "@GE_SDK_CMAKE_DIR@" NO_DEFAULT_PATH)

# Player sources discovered from asset mounts by the build pipeline
set(PLAYER_SOURCES
@GE_DISCOVERED_SOURCES@
)

# Platform-specific executable type
if(WIN32)
    add_executable(Player WIN32 ${PLAYER_SOURCES})
elseif(APPLE)
    add_executable(Player MACOSX_BUNDLE ${PLAYER_SOURCES})
    set_target_properties(Player PROPERTIES
        MACOSX_BUNDLE_GUI_IDENTIFIER "com.gameengine.@GE_GAME_NAME@"
        MACOSX_BUNDLE_BUNDLE_NAME "@GE_GAME_NAME@"
    )
else()
    add_executable(Player ${PLAYER_SOURCES})
endif()

target_link_libraries(Player PRIVATE GameEngine::Engine)
target_compile_features(Player PUBLIC cxx_std_20)

# Windows: the engine headers use std::numeric_limits<>::max()/min() and
# std::max/min; <windows.h> (pulled in transitively) defines max()/min() macros
# unless NOMINMAX is set, which breaks those calls (C2589/C2059).
if(WIN32)
    target_compile_definitions(Player PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
endif()

# Include paths for user headers found in asset mounts
set(PLAYER_INCLUDE_DIRS
@GE_USER_INCLUDE_DIRS@
)
if(PLAYER_INCLUDE_DIRS)
    target_include_directories(Player PRIVATE ${PLAYER_INCLUDE_DIRS})
endif()

# App icon embedding (generated into icons/<Platform>/ by the build pipeline)
@GE_APP_ICON_SECTION@

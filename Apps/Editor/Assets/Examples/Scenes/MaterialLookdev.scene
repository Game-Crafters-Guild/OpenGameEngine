[scene name="MaterialLookdev" version=1]
; Neutral dark studio for judging the OpenPBR hero lobes side by side.
; Eleven balls, one material each, on a staggered two-row stand; the
; brushed-steel capsule and thick-glass cube show the two lobes that a
; sphere cannot read (anisotropic stretch needs a swept tangent, and
; Beer-Lambert path length needs parallel faces).
;
; Key/fill/top/rim are emissive PANELS, not area lights: the reflection
; probe captures them, and that hard-edged rectangle in the coat and
; metal lobes is what makes those lobes legible. Rect area lights are
; deliberately not used here - their specular is point-sampled and
; resolves as a constellation of dots rather than a rectangle. Soft
; diffuse comes from the sky IBL; the sun is a back-right rim with a
; wide angular diameter for a soft contact shadow. Exposure is pinned
; (Manual EV100 14.6) so the poses in captures.json are repeatable.

[entity id="sun"]
HierarchyOrder.order = 10
Light.enabled = true
Light.type = 0
Light.color = (1, 0.96, 0.9)
Light.intensity = 70000
Light.intensityUnit = Lux
Light.castsLight = true
Light.castsShadows = true
Light.cascadeCount = 4
Light.shadowResolutionTier = 0
Light.shadowAngularDiameter = 1.8
Light.useColorTemperature = false
Light.colorTemperature = 6500
Name.value = "Sun (rim)"
Transform.position = (0, 8, 0)
Transform.rotation = (0.3037, 0.3576, -0.1242, 0.8744)
Transform.scale = (1, 1, 1)

[entity id="sky_environment"]
HierarchyOrder.order = 20
Name.value = "Sky Environment"
SkyEnvironment.Enabled = true
SkyEnvironment.Mode = 1
SkyEnvironment.TimeOfDayHours = 9.5
SkyEnvironment.GradientSkyTopColor = (0.30, 0.32, 0.37)
SkyEnvironment.GradientSkyHorizonColor = (0.40, 0.41, 0.44)
SkyEnvironment.GradientSkyBottomColor = (0.16, 0.16, 0.18)
; The sky drives both the IBL fill and the visible cyclorama, so it is the exposure
; knob for this studio. The emissive panels and the glass caustics set the clip point,
; not the sky, so raising this costs no highlights (clipped fraction is flat from
; 17000 to 48000). Below ~24000 the floor and the horizon line crush to black and the
; balls read as floating; above ~48000 the backdrop lifts into the balls' contrast
; range and the lobes flatten.
SkyEnvironment.GradientSkyIntensity = 48000
SkyEnvironment.AnimateTimeOfDay = false
SkyEnvironment.AutoSunMoon = false
SkyEnvironment.TimeOfDayDrivesSunLight = false
SkyEnvironment.SunLight = "sun"
SkyEnvironment.ShowSun = false
SkyEnvironment.ShowMoon = false
SkyEnvironment.IblIntensity = 1
SkyEnvironment.IblLowerHemisphereDarkness = 0.25
SkyEnvironment.SkyExposureTrim = 0
Transform.position = (0, 0, 0)
Transform.rotation = (0, 0, 0, 1)
Transform.scale = (1, 1, 1)

[entity id="main_camera"]
HierarchyOrder.order = 30
Camera.enabled = true
Camera.perspective = true
Camera.fovY = 34
Camera.nearZ = 0.05
Camera.farZ = 500
Camera.exposureControl = 1
Camera.manualExposureEV = 14.6
Camera.exposureCompensation = 0
Camera.antiAliasing = 0
Camera.msaaSamples = 0
Name.value = "Main Camera"
Transform.position = (0, 2.45, -12.6)
Transform.rotation = (0.03256, 0, 0, 0.9995)
Transform.scale = (1, 1, 1)


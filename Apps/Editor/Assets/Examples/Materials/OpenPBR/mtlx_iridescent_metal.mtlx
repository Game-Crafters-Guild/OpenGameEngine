<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <open_pbr_surface name="IridescentMetal" type="surfaceshader">
    <input name="base_color" type="color3" value="1.0, 0.78, 0.34" colorspace="lin_rec709"/>
    <input name="base_metalness" type="float" value="1.0"/>
    <input name="specular_roughness" type="float" value="0.18"/>
    <input name="specular_ior" type="float" value="1.5"/>
    <input name="coat_weight" type="float" value="0.6"/>
    <input name="coat_roughness" type="float" value="0.1"/>
    <input name="thin_film_weight" type="float" value="1.0"/>
    <input name="thin_film_thickness" type="float" value="0.42"/>
    <input name="thin_film_ior" type="float" value="1.45"/>
  </open_pbr_surface>
  <surfacematerial name="M_IridescentMetal" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="IridescentMetal"/>
  </surfacematerial>
</materialx>

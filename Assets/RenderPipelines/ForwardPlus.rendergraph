{
  "constants": {
    "clusterTileSize": 32,
    "depthSlices": 24,
    "maxLightsPerCluster": 32
  },
  "outputs": {
    "FinalColor": "View.Resolve"
  },
  "passes": [
    {
      "buffer": "ViewParams",
      "enabled": true,
      "id": "ViewParamsUpload",
      "type": "ViewParamsUpload"
    },
    {
      "enabled": true,
      "id": "TerrainUpload",
      "type": "TerrainUpload"
    },
    {
      "enabled": true,
      "id": "CBTTerrain",
      "type": "CBTRender"
    },
    {
      "enabled": true,
      "id": "TerrainGrass",
      "type": "TerrainGrass"
    },
    {
      "enabled": true,
      "id": "DepthPrepass",
      "type": "DepthPrepass"
    },
    {
      "enabled": true,
      "id": "DepthResolve",
      "type": "DepthResolve"
    },
    {
      "enabled": true,
      "id": "AmbientOcclusion",
      "quality": "medium",
      "temporal": true,
      "output": "View.GTAO",
      "type": "AmbientOcclusion"
    },
    {
      "buffer": "HeightFogParams",
      "enabled": true,
      "id": "HeightFogParamsUpload",
      "type": "HeightFogParamsUpload"
    },
    {
      "buffer": "LightBuffer",
      "enabled": true,
      "id": "LightUpload",
      "type": "LightUpload"
    },
    {
      "bufferUsages": {
        "DepthMinMaxBuffer": "StorageWrite"
      },
      "buffers": {
        "DepthMinMaxBuffer": "DepthMinMaxBuffer"
      },
      "dispatch": {
        "x": "ceil(renderWidth / 32)",
        "y": "ceil(renderHeight / 32)",
        "z": 1
      },
      "enabled": true,
      "id": "DepthMinMax",
      "idleElide": true,
      "inputUsages": {
        "DepthTex": "Sampled"
      },
      "inputs": {
        "DepthTex": "View.DepthResolved"
      },
      "shaderPkg": "Shaders/cluster_depth_minmax.shaderpkg",
      "targetBuffer": "DepthMinMaxBuffer",
      "type": "ComputeShader"
    },
    {
      "buffer": "ShadowData",
      "cascades": 4,
      "depthBias": 0.0001,
      "enabled": true,
      "id": "CascadedShadowMap",
      "maxShadowDistance": 200.0,
      "normalBias": 0.5,
      "resolution": 2048,
      "splitLambda": 0.75,
      "type": "ShadowMap"
    },
    {
      "bufferUsages": {
        "ClusterBuffer": "StorageWrite",
        "ClusterParams": "Sampled",
        "DepthMinMaxBuffer": "StorageRead",
        "LightBuffer": "StorageRead",
        "LightIndexBuffer": "StorageWrite",
        "ViewParams": "ConstantBuffer"
      },
      "buffers": {
        "ClusterBuffer": "ClusterBuffer",
        "ClusterParams": "ClusterParams",
        "DepthMinMaxBuffer": "DepthMinMaxBuffer",
        "LightBuffer": "LightBuffer",
        "LightIndexBuffer": "LightIndexBuffer",
        "ViewParams": "ViewParams"
      },
      "dispatch": {
        "x": "ceil(renderWidth / 32)",
        "y": "ceil(renderHeight / 32)",
        "z": 24
      },
      "enabled": true,
      "id": "ClusteredLightCull",
      "idleElide": true,
      "requiresLights": true,
      "shaderPkg": "Shaders/clustered_light_cull.shaderpkg",
      "targetBuffer": "LightIndexBuffer",
      "type": "ComputeShader",
      "uniformWrites": {
        "ClusterParams": {
          "u32x4": [
            32,
            32,
            24,
            32
          ]
        }
      }
    },
    {
      "enabled": true,
      "id": "Sky",
      "output": "View.Color",
      "type": "SkyRender"
    },
    {
      "enabled": true,
      "id": "IBLGen",
      "type": "IBLGen"
    },
    {
      "enabled": true,
      "id": "DDGI",
      "type": "DDGIGen"
    },
    {
      "enabled": true,
      "id": "Ocean",
      "type": "OceanRender"
    },
    {
      "colorResolveTarget": "SceneColor",
      "enabled": true,
      "id": "World",
      "keywords": [
        "ForwardPlus",
        "Instanced",
        "Shadows",
        "IBL"
      ],
      "type": "WorldRender"
    },
    {
      "enabled": true,
      "id": "HZBBuild",
      "type": "HZBBuild"
    },
    {
      "enabled": true,
      "id": "OcclusionCullP2",
      "type": "OcclusionCullP2"
    },
    {
      "enabled": true,
      "id": "ScatterB",
      "type": "ScatterB"
    },
    {
      "enabled": true,
      "id": "SortedTransparent",
      "keywords": [
        "ForwardPlus",
        "Instanced",
        "Shadows",
        "IBL"
      ],
      "type": "SortedTransparent"
    },
    {
      "enabled": true,
      "id": "OceanUnderwater",
      "mode": "underwater",
      "type": "OceanRender"
    },
    {
      "enabled": true,
      "id": "Transmissive",
      "keywords": [
        "ForwardPlus",
        "Instanced",
        "Shadows",
        "IBL"
      ],
      "type": "TransmissiveRender"
    },
    {
      "enabled": true,
      "id": "ScreenSpaceReflections",
      "input": "SceneColor",
      "output": "HDRSSSR",
      "type": "ScreenSpaceReflections"
    },
    {
      "alphaBlend": true,
      "bufferUsages": {
        "ClusterBuffer": "StorageRead",
        "ClusterParams": "Sampled",
        "LightIndexBuffer": "StorageRead"
      },
      "buffers": {
        "ClusterBuffer": "ClusterBuffer",
        "ClusterParams": "ClusterParams",
        "LightIndexBuffer": "LightIndexBuffer"
      },
      "enabled": false,
      "id": "ClusterDebugOverlay",
      "output": "View.Color",
      "shaderPkg": "Shaders/cluster_debug_overlay.shaderpkg",
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "AtmosphericCloudLayer",
      "inputs": {
        "uSceneColor": "HDRSSSR",
        "uDepth": "View.DepthResolved"
      },
      "inputUsages": {
        "uDepth": "Sampled"
      },
      "buffers": {
        "ViewParams": "ViewParams"
      },
      "bufferUsages": {
        "ViewParams": "ConstantBuffer"
      },
      "output": "AtmosphericCloudLayer",
      "passthroughInput": "uSceneColor",
      "ppOverrides": true,
      "pushConstants": {
        "atmosSkyFill": 0.0,
        "atmosVaporMass": 0.0,
        "atmosCloudColorR": 1.0,
        "atmosCloudColorG": 1.0,
        "atmosCloudColorB": 1.0,
        "atmosOpacity": 1.0,
        "atmosFloorHeight": 900.0,
        "atmosLayerDepth": 1800.0,
        "atmosBodyFrequency": 0.72,
        "atmosEdgeFrequency": 3.2,
        "atmosEdgeBreakup": 0.58,
        "atmosDriftAngle": 24.0,
        "atmosDriftRate": 0.08,
        "atmosSunFade": 0.55,
        "atmosSkyBounce": 0.32,
        "atmosRimBoost": 0.42,
        "atmosOcclusion": 0.55,
        "atmosHistoryWeight": 0.9,
        "atmosPixelScale": 0.75
      },
      "samplers": {
        "uDepth": "LinearClamp",
        "uSceneColor": "LinearClamp"
      },
      "shaderPkg": "Shaders/atmospheric_cloud_layer.shaderpkg",
      "skipWhen": {
        "atmosphericCloudActive": 0.0
      },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "CloudShapeNoiseBake",
      "buffers": {
        "NoiseMinMax": "CloudShapeNoiseMinMax"
      },
      "bufferUsages": {
        "NoiseMinMax": "StorageWrite"
      },
      "dispatch": {
        "x": 16,
        "y": 16,
        "z": 16
      },
      "runOnce": true,
      "skipWhen": {
        "volumetricCloudsActive": 0.0
      },
      "shaderPkg": "Shaders/volumetric_clouds_shape_noise.shaderpkg",
      "targetTexture": "CloudShapeNoise",
      "type": "ComputeShader"
    },
    {
      "enabled": true,
      "id": "CloudShapeNoiseNormalize",
      "buffers": {
        "NoiseMinMax": "CloudShapeNoiseMinMax"
      },
      "bufferUsages": {
        "NoiseMinMax": "StorageRead"
      },
      "dispatch": {
        "x": 16,
        "y": 16,
        "z": 16
      },
      "runOnce": true,
      "skipWhen": {
        "volumetricCloudsActive": 0.0
      },
      "shaderPkg": "Shaders/volumetric_clouds_noise_normalize.shaderpkg",
      "targetTexture": "CloudShapeNoise",
      "targetTextureReadWrite": true,
      "type": "ComputeShader",
      "shaderSourceOverrides": {
        "wgsl": null
      }
    },
    {
      "enabled": true,
      "id": "CloudDetailNoiseBake",
      "buffers": {
        "NoiseMinMax": "CloudDetailNoiseMinMax"
      },
      "bufferUsages": {
        "NoiseMinMax": "StorageWrite"
      },
      "dispatch": {
        "x": 4,
        "y": 4,
        "z": 4
      },
      "runOnce": true,
      "skipWhen": {
        "volumetricCloudsActive": 0.0
      },
      "shaderPkg": "Shaders/volumetric_clouds_detail_noise.shaderpkg",
      "targetTexture": "CloudDetailNoise",
      "type": "ComputeShader"
    },
    {
      "enabled": true,
      "id": "CloudDetailNoiseNormalize",
      "buffers": {
        "NoiseMinMax": "CloudDetailNoiseMinMax"
      },
      "bufferUsages": {
        "NoiseMinMax": "StorageRead"
      },
      "dispatch": {
        "x": 4,
        "y": 4,
        "z": 4
      },
      "runOnce": true,
      "skipWhen": {
        "volumetricCloudsActive": 0.0
      },
      "shaderPkg": "Shaders/volumetric_clouds_noise_normalize.shaderpkg",
      "targetTexture": "CloudDetailNoise",
      "targetTextureReadWrite": true,
      "type": "ComputeShader",
      "shaderSourceOverrides": {
        "wgsl": null
      }
    },
    {
      "enabled": true,
      "id": "VolumetricCloudsParamsUpload",
      "buffer": "CloudParams",
      "type": "VolumetricCloudsParamsUpload"
    },
    {
      "enabled": true,
      "id": "VolumetricCloudsMarch",
      "inputs": {
        "uDepth": "View.DepthResolved",
        "uShapeNoise": "CloudShapeNoise",
        "uDetailNoise": "CloudDetailNoise"
      },
      "inputUsages": {
        "uDepth": "Sampled",
        "uShapeNoise": "Sampled",
        "uDetailNoise": "Sampled"
      },
      "buffers": {
        "ViewParams": "ViewParams",
        "CloudParams": "CloudParams"
      },
      "bufferUsages": {
        "ViewParams": "ConstantBuffer",
        "CloudParams": "ConstantBuffer"
      },
      "shaderSourceOverrides": {
        "wgsl": {
          "buffers": {
            "ShapeNoiseMinMax": "CloudShapeNoiseMinMax",
            "DetailNoiseMinMax": "CloudDetailNoiseMinMax"
          },
          "bufferUsages": {
            "ShapeNoiseMinMax": "StorageRead",
            "DetailNoiseMinMax": "StorageRead"
          }
        }
      },
      "output": "CloudMarch",
      "ppOverrides": true,
      "pushConstants": {
        "shaderAnimationTime": 0.0
      },
      "samplers": {
        "uDepth": "LinearClamp",
        "uShapeNoise": "LinearRepeat",
        "uDetailNoise": "LinearRepeat"
      },
      "shaderPkg": "Shaders/volumetric_clouds_march.shaderpkg",
      "skipWhen": {
        "volumetricCloudsActive": 0.0
      },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "VolumetricCloudsResolve",
      "inputs": {
        "uMarch": "CloudMarch"
      },
      "buffers": {
        "ViewParams": "ViewParams",
        "CloudParams": "CloudParams"
      },
      "bufferUsages": {
        "ViewParams": "ConstantBuffer",
        "CloudParams": "ConstantBuffer"
      },
      "output": "CloudResolve",
      "pushConstants": {
        "cloudsHistoryValid": 0.0
      },
      "samplers": {
        "uMarch": "LinearClamp",
        "uHistory": "LinearClamp"
      },
      "temporalHistory": {
        "binding": "uHistory",
        "validPushConstant": "cloudsHistoryValid"
      },
      "stitchWhenSkipped": false,
      "shaderPkg": "Shaders/volumetric_clouds_resolve.shaderpkg",
      "skipWhen": {
        "volumetricCloudsActive": 0.0
      },
      "type": "TemporalFullscreenShader"
    },
    {
      "enabled": true,
      "id": "VolumetricCloudsComposite",
      "inputs": {
        "uSceneColor": "AtmosphericCloudLayer",
        "uClouds": "CloudResolve"
      },
      "buffers": {
        "CloudParams": "CloudParams"
      },
      "bufferUsages": {
        "CloudParams": "ConstantBuffer"
      },
      "output": "VolumetricClouds",
      "passthroughInput": "uSceneColor",
      "samplers": {
        "uClouds": "LinearClamp",
        "uSceneColor": "LinearClamp"
      },
      "shaderPkg": "Shaders/volumetric_clouds_composite.shaderpkg",
      "skipWhen": {
        "volumetricCloudsActive": 0.0
      },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "FogGlowSceneSource",
      "inputs": { "uTex": "VolumetricClouds" },
      "output": "FogGlowSceneSource",
      "samplers": { "uTex": "LinearClamp" },
      "shaderPkg": "Shaders/copy.shaderpkg",
      "skipWhen": { "fogGlowActive": 0.0 },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "VolumetricFog",
      "output": "VolumetricClouds",
      "type": "VolumetricFog"
    },
    {
      "enabled": true,
      "id": "HeightFog",
      "inputs": {
        "uSceneColor": "VolumetricClouds",
        "uDepth": "View.DepthResolved"
      },
      "inputUsages": {
        "uDepth": "Sampled"
      },
      "buffers": {
        "ViewParams": "ViewParams",
        "HeightFogParams": "HeightFogParams"
      },
      "bufferUsages": {
        "ViewParams": "ConstantBuffer",
        "HeightFogParams": "ConstantBuffer"
      },
      "output": "HDRHeightFog",
      "passthroughInput": "uSceneColor",
      "samplers": {
        "uDepth": "LinearClamp",
        "uSceneColor": "LinearClamp"
      },
      "shaderPkg": "Shaders/height_fog.shaderpkg",
      "skipWhen": {
        "heightFogActive": 0.0
      },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "FogGlowFast",
      "inputs": {
        "uFogged": "HDRHeightFog",
        "uSceneSource": "FogGlowSceneSource"
      },
      "output": "HDRFogGlowFast",
      "passthroughInput": "uFogged",
      "ppOverrides": true,
      "pushConstants": {
        "fogGlowIntensity": 0.0,
        "fogGlowRadius": 3.0,
        "fogGlowThreshold": 0.0,
        "fogGlowKnee": 0.5,
        "fogGlowFadeStart": 0.05,
        "fogGlowFadeEnd": 0.8,
        "fogGlowTintR": 1.0,
        "fogGlowTintG": 1.0,
        "fogGlowTintB": 1.0,
        "fogGlowAntiFlicker": 1
      },
      "samplers": {
        "uFogged": "LinearClamp",
        "uSceneSource": "LinearClamp"
      },
      "shaderPkg": "Shaders/fog_glow_fast.shaderpkg",
      "skipWhen": { "fogGlowFastActive": 0.0 },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "FogGlowPrefilter",
      "inputs": {
        "uFogged": "HDRFogGlowFast",
        "uSceneSource": "FogGlowSceneSource"
      },
      "output": "FogGlowHalf",
      "ppOverrides": true,
      "pushConstants": {
        "fogGlowThreshold": 0.0,
        "fogGlowKnee": 0.5,
        "fogGlowFadeStart": 0.05,
        "fogGlowFadeEnd": 0.8,
        "fogGlowTintR": 1.0,
        "fogGlowTintG": 1.0,
        "fogGlowTintB": 1.0,
        "fogGlowAntiFlicker": 1
      },
      "samplers": {
        "uFogged": "LinearClamp",
        "uSceneSource": "LinearClamp"
      },
      "shaderPkg": "Shaders/fog_glow_prefilter.shaderpkg",
      "skipWhen": { "fogGlowPyramidActive": 0.0 },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "FogGlowDownQuarter",
      "inputs": { "uSrc": "FogGlowHalf" },
      "output": "FogGlowQuarter",
      "ppOverrides": true,
      "pushConstants": { "fogGlowAntiFlicker": 1, "antiFlickerStage": 1 },
      "samplers": { "uSrc": "LinearClamp" },
      "shaderPkg": "Shaders/fog_glow_downsample.shaderpkg",
      "skipWhen": { "fogGlowPyramidActive": 0.0 },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "FogGlowDownEighth",
      "inputs": { "uSrc": "FogGlowQuarter" },
      "output": "FogGlowEighth",
      "ppOverrides": true,
      "pushConstants": { "fogGlowAntiFlicker": 1, "antiFlickerStage": 0 },
      "samplers": { "uSrc": "LinearClamp" },
      "shaderPkg": "Shaders/fog_glow_downsample.shaderpkg",
      "skipWhen": { "fogGlowPyramidActive": 0.0 },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "FogGlowDownSixteenth",
      "inputs": { "uSrc": "FogGlowEighth" },
      "output": "FogGlowSixteenth",
      "ppOverrides": true,
      "pushConstants": { "fogGlowAntiFlicker": 1, "antiFlickerStage": 0 },
      "samplers": { "uSrc": "LinearClamp" },
      "shaderPkg": "Shaders/fog_glow_downsample.shaderpkg",
      "skipWhen": { "fogGlowOctave4Active": 0.0 },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "FogGlowDownThirtySecond",
      "inputs": { "uSrc": "FogGlowSixteenth" },
      "output": "FogGlowThirtySecond",
      "ppOverrides": true,
      "pushConstants": { "fogGlowAntiFlicker": 1, "antiFlickerStage": 0 },
      "samplers": { "uSrc": "LinearClamp" },
      "shaderPkg": "Shaders/fog_glow_downsample.shaderpkg",
      "skipWhen": { "fogGlowOctave5Active": 0.0 },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "FogGlowDownSixtyFourth",
      "inputs": { "uSrc": "FogGlowThirtySecond" },
      "output": "FogGlowSixtyFourth",
      "ppOverrides": true,
      "pushConstants": { "fogGlowAntiFlicker": 1, "antiFlickerStage": 0 },
      "samplers": { "uSrc": "LinearClamp" },
      "shaderPkg": "Shaders/fog_glow_downsample.shaderpkg",
      "skipWhen": { "fogGlowOctave6Active": 0.0 },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "FogGlowDownOneTwentyEighth",
      "inputs": { "uSrc": "FogGlowSixtyFourth" },
      "output": "FogGlowOneTwentyEighth",
      "ppOverrides": true,
      "pushConstants": { "fogGlowAntiFlicker": 1, "antiFlickerStage": 0 },
      "samplers": { "uSrc": "LinearClamp" },
      "shaderPkg": "Shaders/fog_glow_downsample.shaderpkg",
      "skipWhen": { "fogGlowOctave7Active": 0.0 },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "FogGlowDownTwoFiftySixth",
      "inputs": { "uSrc": "FogGlowOneTwentyEighth" },
      "output": "FogGlowTwoFiftySixth",
      "ppOverrides": true,
      "pushConstants": { "fogGlowAntiFlicker": 1, "antiFlickerStage": 0 },
      "samplers": { "uSrc": "LinearClamp" },
      "shaderPkg": "Shaders/fog_glow_downsample.shaderpkg",
      "skipWhen": { "fogGlowOctave8Active": 0.0 },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "FogGlowGather",
      "inputs": {
        "uFogGlow0": "FogGlowHalf",
        "uFogGlow1": "FogGlowQuarter",
        "uFogGlow2": "FogGlowEighth",
        "uFogGlow3": "FogGlowSixteenth",
        "uFogGlow4": "FogGlowThirtySecond",
        "uFogGlow5": "FogGlowSixtyFourth",
        "uFogGlow6": "FogGlowOneTwentyEighth",
        "uFogGlow7": "FogGlowTwoFiftySixth"
      },
      "output": "FogGlowNormalized",
      "ppOverrides": true,
      "pushConstants": {
        "fogGlowOctaves": 6,
        "fogGlowSampleScale": 1.0,
        "fogGlowScatter": 0.7
      },
      "samplers": {
        "uFogGlow0": "LinearClamp", "uFogGlow1": "LinearClamp",
        "uFogGlow2": "LinearClamp", "uFogGlow3": "LinearClamp",
        "uFogGlow4": "LinearClamp", "uFogGlow5": "LinearClamp",
        "uFogGlow6": "LinearClamp", "uFogGlow7": "LinearClamp"
      },
      "shaderPkg": "Shaders/fog_glow_gather.shaderpkg",
      "skipWhen": { "fogGlowPyramidActive": 0.0 },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "FogGlowComposite",
      "inputs": { "uHDR": "HDRFogGlowFast", "uFogGlow": "FogGlowNormalized" },
      "output": "HDRFogGlow",
      "passthroughInput": "uHDR",
      "ppOverrides": true,
      "pushConstants": { "fogGlowIntensity": 0.0 },
      "samplers": { "uHDR": "LinearClamp", "uFogGlow": "LinearClamp" },
      "shaderPkg": "Shaders/fog_glow_composite.shaderpkg",
      "skipWhen": { "fogGlowPyramidActive": 0.0 },
      "type": "FullscreenShader"
    },
    {
      "enabled": true,
      "id": "LensFlare",
      "output": "HDRFogGlow",
      "type": "LensFlare"
    },
    {
      "enabled": true,
      "id": "SunGlare",
      "output": "HDRFogGlow",
      "type": "SunGlare"
    },
    {
      "enabled": true,
      "id": "HeatDistortion",
      "inputs": {
        "uSceneColor": "HDRFogGlow",
        "uDepth": "View.DepthResolved"
      },
      "inputUsages": {
        "uDepth": "Sampled"
      },
      "buffers": {
        "ViewParams": "ViewParams"
      },
      "bufferUsages": {
        "ViewParams": "ConstantBuffer"
      },
      "output": "HDRHeatDistortion",
      "passthroughInput": "uSceneColor",
      "ppOverrides": true,
      "pushConstants": {
        "heatDistortionStrength": 0.0,
        "heatDistortionSpeed": 1.15,
        "heatDistortionScale": 11.0,
        "heatDistortionMaskStrength": 1.0,
        "heatDistortionDistanceStart": 0.02,
        "heatDistortionDistanceEnd": 0.14,
        "heatDistortionDirectionalFalloff": 4.0,
        "heatDistortionUseAbsoluteY": 1,
        "heatDistortionSoftness": 1.0
      },
      "samplers": {
        "uDepth": "LinearClamp",
        "uSceneColor": "LinearClamp"
      },
      "shaderPkg": "Shaders/heat_distortion.shaderpkg",
      "skipWhen": {

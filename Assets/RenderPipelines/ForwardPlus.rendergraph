    "LightIndexBuffer": {
      "kind": "Buffer",
      "memoryUsage": "DeviceLocal",
      "scope": "PerView",
      "size": {
        "expression": "clustersX * clustersY * depthSlices * maxLightsPerCluster * indexBytes",
        "variables": {
          "clustersX": "ceil(renderWidth / clusterTileSize)",
          "clustersY": "ceil(renderHeight / clusterTileSize)",
          "indexBytes": 4
        }
      },

[scene name="Gate1Content" version=1]
; Gate-1 formal content scene: skinned + animated character (Fox), textured
; static models (Duck, Lantern), 4-cascade sun shadows, and a cube field that
; extends well past the frustum so GPU culling has real work. All model refs
; are PATH-based (resolved to GUIDs by the asset registry at load).

; ---- Lighting / sky -------------------------------------------------------

[entity id="e_3001"]
Light.type = 0
Light.color = (1, 0.96, 0.9)
Light.intensity = 2.5
Light.castsShadows = true
Light.castsLight = true
Light.cascadeCount = 4
Name.value = "Sun"
Transform.position = (0, 10, 0)
Transform.rotation = (0.35, 0.27, -0.1, 0.89)
Transform.scale = (1, 1, 1)


[entity id="e_3002"]
Light.type = 3
Light.color = (0.6, 0.65, 0.75)
Light.intensity = 0.35
Name.value = "Ambient"
Transform.position = (0, 0, 0)
Transform.rotation = (0, 0, 0, 1)
Transform.scale = (1, 1, 1)


[entity id="e_3003"]
SkyEnvironment.TimeOfDayHours = 14.5
SkyEnvironment.AutoSunMoon = false
Name.value = "Sky"
Transform.position = (0, 0, 0)
Transform.rotation = (0, 0, 0, 1)
Transform.scale = (1, 1, 1)


; ---- Ground ---------------------------------------------------------------

[entity id="e_3010"]
MeshRenderer.meshPrimitive = Plane
MeshRenderer.renderLayerMask = 1
MeshRenderer.castShadows = false
MeshRenderer.receiveShadows = true
Name.value = "Ground"
Transform.position = (0, 0, 0)
Transform.rotation = (0, 0, 0, 1)
Transform.scale = (60, 1, 60)


; ---- Animated fox (skinned; embedded clips: Survey / Walk / Run) ---------

[entity id="e_3100"]
MeshRenderer.meshAsset = [path="Models/Fox/Fox.glb"]
MeshRenderer.renderLayerMask = 1
MeshRenderer.castShadows = true
MeshRenderer.receiveShadows = true
Animator.active = true
Animator.loop = true
Animator.source = "Clip"
Animator.assignedAnimation = "Run"
Animator.autoPlayOnEnterPlayMode = true
Name.value = "Fox"
Transform.position = (-1.5, 0, 2)
Transform.rotation = (0, 0.38, 0, 0.92)
Transform.scale = (0.025, 0.025, 0.025)


[entity id="e_3101"]
MeshRenderer.meshAsset = [path="Models/Fox/Fox.glb"]
MeshRenderer.renderLayerMask = 1
MeshRenderer.castShadows = true
MeshRenderer.receiveShadows = true
Animator.active = true
Animator.loop = true
Animator.source = "Clip"
Animator.assignedAnimation = "Survey"
Animator.autoPlayOnEnterPlayMode = true
Name.value = "FoxSurvey"
Transform.position = (2.5, 0, 3.5)
Transform.rotation = (0, -0.5, 0, 0.866)
Transform.scale = (0.025, 0.025, 0.025)



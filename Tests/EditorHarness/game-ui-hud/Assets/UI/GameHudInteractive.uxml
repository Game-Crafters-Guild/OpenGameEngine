<uielement id="hud-root" class="hud-root">
    <uielement id="hp-panel" class="hp-panel hud-hit">
        <label class="hp-title" text="HEALTH" />
        <uielement class="hp-track">
            <uielement id="hp-fill" class="hp-fill" />
        </uielement>
        <label id="hp-label" class="hp-label" text="-- / --" />
    </uielement>
    <button id="damage-btn" class="damage-btn hud-hit" text="TAKE DAMAGE" />
    <textfield id="chat-input" class="chat-input hud-hit" />
</uielement>

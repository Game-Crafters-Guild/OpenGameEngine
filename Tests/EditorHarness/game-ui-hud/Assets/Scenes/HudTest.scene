[scene name="HudTest" version=1]
; Game UI HUD smoke scene: camera + sun + ambient + sky + ground + cube, plus a
; UIDocument entity that mounts GameHudTest.uxml/.css. The Player composites the
; HUD over FinalColor; --screenshot captures it for headless verification.


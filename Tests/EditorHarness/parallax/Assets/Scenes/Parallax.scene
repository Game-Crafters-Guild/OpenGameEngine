[scene name="Parallax" version=1]
; Parallax materials test and visualisation scene. Three height-mapped standard materials: a
; cobbled ground (2 m repeat), a brick wall facing the camera (1 m repeat) and the tiled roof of a
; lean-to house, pitched 25 degrees away from the camera (2 m repeat), under a low sun from behind the
; camera's left (27 degrees up) so the relief's self-shadow falls across the mortar, the stone gaps
; and the tile lips.
;
; Poses (scene view camera; eye in metres, yaw and pitch in degrees, look =
; (cos p cos y, sin p, cos p sin y)):
;   PG  eye (0, 1.7, -8)        yaw 90  pitch -6    eye height, the ground running to the wall
;   PW  eye (-3, 1.7, 14)       yaw 60  pitch 0     eye height, the wall 6 m away, oblique
;   P1  eye (0, 12.34, -2.71)   yaw 90  pitch -40   overhead at 19.2 m, pivot (0, 0, 12)
;   P2  eye (0, 33.94, -28.45)  yaw 90  pitch -40   overhead at 52.8 m, pivot (0, 0, 12)
;   P4  eye (14, 20.21, -4.71)  yaw 90  pitch -40   overhead at 19.2 m on the roof, 75 deg to its normal

[entity id="e_sun"]
Light.type = 0
Light.color = (1, 0.96, 0.9)
Light.intensity = 1e+05
Light.intensityUnit = Lux
Light.castsLight = true
Light.castsShadows = true
Name.value = "Sun"
Transform.position = (0, 10, 0)
Transform.rotation = (0.2686, 0.4776, 0, 0.8365)
Transform.scale = (1, 1, 1)


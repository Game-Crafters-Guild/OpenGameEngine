**/Testing/Temporary/
**/Testing/TAG


# External vendors (not tracked)
External/SaschaWillems-Vulkan-glTF-PBR/

# GPU driver logs (local, transient)
NVIDIA Corporation/
NVIDIA Corporation/**

# Local transient run outputs and debug dumps
# Build-log captures (`... > cl_<tag>.txt` redirects used while iterating)
cl_*.txt
*-debug.txt
corebridge-debug.txt
coreclrhost-debug.txt
scriptingabi-debug.txt
fox_main_enter.txt
out.txt
sdf_atlas.pgm
test-out.txt
test_run.txt
test_verbose_log.txt
.clang-tidy-filelist.txt

# Core dumps dropped at the repo root (e.g. ShaderReflect crashing under
# Lima/Rosetta during the SteamDeck cross-build, which mounts the repo as /src)
/core
/core.[0-9]*

# Legacy / local Steam Deck cross-build artifacts (use Tools/ShaderReflectHost instead)
.steamdeck-shader-tools/
.steamdeck-host-tools/

# Additional debug artifacts (msdf/text rendering dumps)
debug_*.txt
*_debug*.txt
msdf_atlas_*.txt
msdf_atlas_page*.ppm


# IDE intermediate caches
ipch/
**/ipch/
*.ipch
*.pch

# vcpkg binary cache (local, per-repo)
.vcpkg/
.vcpkg/**

# CLion build folder
cmake-build-debug/*

# Cursor related folders
.cursor/plans

# Claude Code (local settings and agent worktrees)
.claude/settings.local.json
.claude/worktrees/
# Worktrees kept inside the checkout
.worktrees/
# Claude Code session artifacts
.claude/scheduled_tasks.lock
# Skills are local by default; shared team skills are re-included explicitly.
.claude/skills/*
!.claude/skills/trace-the-chain/
!.claude/skills/adversarial-review/
!.claude/skills/root-cause-debugging/
!.claude/skills/empirical-validation/
!.claude/skills/html-doc-format/

# Temporary screenshots
ss*.png

# Session-specific docs (not needed in repo)
docs/CSM_SESSION6_RESUME.md
docs/MCP_PLAN.md
mcp/dist/
mcp/node_modules/

# Auto-generated by ScriptManager at runtime (Engine/Source/Scripting/ScriptManager.cpp).
# Machine-specific (absolute OutputPath + EngineBinDir = the editor exe dir), so it
# must never be tracked. Match the filename at any depth: it sits at the root of
# whichever project the editor opens.
GameEngine.Scripts.csproj
GameEngine.Scripts.csproj.lscache

# Editor's per-project AssetDatabase cache (regenerated on demand)
integration_test_assets/.Cache/

# The FetchBlendTestSamples fixture download (optional .blend test samples)
Tests/BlendSamples/

# On-demand FBX fixtures (FetchFbxTestFixtures) + sidecars the editor
# may regenerate next to them — store-licensed payload, never committed.
Assets/Models/FBXTest/*.fbx
Assets/Models/FBXTest/*.humanoidrig.json
Assets/Models/FBXTest/*.retargetmap.json
Assets/Models/FBXTest/*.anim.json

# Renderer perf-bench hermetic project, and every benchmark results/ directory
# under Tools (ECSBenchCompare writes results/ecs_bench_results.json).
Tools/Benchmarks/Rendering/perf-bench/bench-project*/
Tools/**/results/

# AI-tooling local state directories (per-machine session state, never repo content)
.agents/
.codex/
.playwright-mcp/

# Python bytecode
__pycache__/

# UI replay per-label output dirs (out_<label>/), regenerated by the harness
Tests/UIReplay/out_*/

# Quarantine for keep-local working files awaiting a delete/keep decision
# (moved here to declutter git status; MANIFEST.md inside maps origins)
/.local-attic/

# NativeScripting UserProjectGenerator output in the default player project —
# machine-specific baked SDK path, regenerated on project open (same class as
# the GameEngine.Scripts.csproj rule above)
/Apps/Editor/Player/assets/CMakeLists.txt

# Local desktop build inputs for isolated wasm builds (GE_WEB_SHADERPKG_DIR/GE_WEB_MATERIAL_COOK point here)
/prereq/

# Editor runtime app-data trees dropped next to integration-test projects
# (<name>-runtimeappdata/) and the APPDATA redirect of isolated worktree builds.
**/*runtimeappdata*/
_appdata/

# Lane report folders (evidence, STATUS.md, ledgers) live outside the tree
# under C:/Dev/_reports; refuse any that land inside.
_reports/

# Licensed Sponza content never enters the repository, whichever project it is copied into.
**/Assets/Sponza/

# The unity-import package vendors the converter assembly built by its own
# repository (Packages/unity-import/Tools/UnityConverter.dll.source).
!/Packages/unity-import/Tools/UnityConverter.dll

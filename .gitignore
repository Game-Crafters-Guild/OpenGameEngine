*.vcxproj.user
*.vcxproj.filters
*.sln.docstates
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/
.vscode/
*.VC.db
*.VC.VC.opendb



# C++ compiled files
*.o
*.obj
*.exe
*.dll
*.lib

# C# compiled files
*.dll
*.exe
*.pdb
*.cache
bin/
obj/
packages/
# The NuGet 'packages/' rule above must not eat the engine's packages or its
# package-system source directories (case-insensitive match on Windows).
!/Packages/
!Engine/Include/Assets/Packages/
!Engine/Source/Assets/Packages/
!Apps/Editor/Include/Packages/
!Apps/Editor/Source/Packages/
!docs/Packages/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# .NET Core
.dotnet/
.nuget/

# Asset build artifacts
*.meta.tmp
*.asset.cache
AssetCache/
TempAssets/

# Derived caches (safe to delete)
.Cache/
.Editor/

# Logs
*.log
logs/
engine.log
debug.log
error.log

# UI text debug dumps (generated by UI replay / debug tooling)
UI_TextDebug*.txt

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# IDE specific
*.sublime-project
*.sublime-workspace
.idea/
*.iml
*.ipr
*.iws

# Profiling
*.psess
*.vsp
*.vspx
*.sap

# Code coverage
*.coverage
*.coveragexml
coverage/

# Test results
TestResults/
*.trx
pp.xml
pp2.xml
pp_corebridge.xml
pp_scripts.xml

# Generated capture formats. CSV is only ever a capture (frame timings, profiler
# dumps, benchmark rows) and JSONL only ever a run log (UI replay logs, editor
# debug captures); no tracked source input uses either extension. JSON stays
# allowed: manifests, presets and editor assets are real inputs.
*.csv
*.jsonl

# Package managers
node_modules/
bower_components/
package-lock.json
# Keep the MCP server's lockfile for reproducible `npm ci` installs.
!mcp/package-lock.json
# And the web library's, for the same reason.
!Apps/WebLibrary/ts/package-lock.json

# Dependencies (automated dependency management)
dependencies/
!dependencies/README.md

# Pinned Emscripten SDK install (provisioned by Tools/emsdk/setup.sh)
Tools/emsdk/emsdk
# A wasm configure re-provisions a second SDK copy at the repo root (emsdk's
# own installer resolves relative to the invoking directory). Derived, ~1.7 GB.
/emsdk/

# Test artifacts (temporary files generated during testing)
# Note: Test artifacts are now organized in Tests/ directory
Tests/*-test.png
Tests/*-debug.png
Tests/console_screenshot.png
Tests/integration-*.png
Tests/test_results.xml
Tests/temp_*

# UI text debug artifacts
text_glyph_*.png
text_font_debug.txt
text_debug.txt

# NOTE: AssetDatabase.assetdb is the authoritative GUID store — it MUST
# be tracked in git so all team members share the same asset GUIDs.
# Scene references and the rest of the asset system rely on GUIDs being
# stable across machines. Only the derived cache (.Cache/AssetDatabase/)
# and the per-user editor scratch (.Editor/) should be ignored.
# Stray repo-root .assetdb (test droppings if a test cd's to the repo root)
# is ignored; canonical project DBs (Apps/Editor/Player/, Tests/Projects/.../) are tracked.
/AssetDatabase.assetdb
# Advisory lock sidecar beside an asset store more than one process can write
# (an engine package's manifest, authored through the editor).
*.assetmanifest.lock
# Integration test scratch tree (recursive nesting from buggy test cleanup)
integration_test_assets/

# MCP Integration Screenshots (generated during testing)
*.bmp
screenshot*.png
debug_screenshot.png
mcp_*.png
console_screenshot.png

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Game specific
Screenshots/
Recordings/
UserSettings/
SaveData/
Crashes/

# Local Player runtime artifacts
PlayerRuntime/
PlayerData/
PlayerSettings.json
Player.log
Player_*.log
Apps/Player/Runtime/
Apps/Player/PlayerData/
Apps/Player/UserSettings/

# Asset source files (keep compiled assets, ignore sources)
# Uncomment these if you want to ignore large source assets
# *.psd
# *.ai
# *.blend
# *.max
# *.ma
# *.mb

# Keep important files
!Assets/.gitkeep
!Scripts/.gitkeep
!Engine/.gitkeep

# Documentation build
docs/_build/
docs/html/
docs/latex/

# Backup files
*.bak
*.backup
*.orig

# JetBrains Rider
.idea/
*.sln.iml

# MonoDevelop
*.pidb
*.userprefs

# Unity (if integrating Unity assets)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# The unanchored [Bb]uild/ pattern above (from the Unity .gitignore template) also
# matches in-tree source directories named Build/. That silently dropped engine
# source files (e.g. Engine/Source/Engine/Build/CancellableShellProcess.cpp) from
# commits. Keep these source directories tracked.
!/Engine/Include/Engine/Build/
!/Engine/Source/Engine/Build/
!/mcp/src/build/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
# NOTE: We DO want to include .csproj and .sln files for the game engine!
# *.csproj  # COMMENTED OUT - We need these for C# compilation
*.unityproj
# *.sln     # COMMENTED OUT - We need these for the solution
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

